#!/usr/bin/env python3
"""Check runs of pigeon's own code against the TLA+ models (ADR 0008, 13 §13.3).

`cargo test` writes NDJSON traces of pigeon-core's simulated runs (feature
`tla-trace`); each becomes a TLA+ module through scripts/trace-to-tla, and TLC
checks it with its *Trace.tla specification: every run must be accepted. A
mutant of each run (a logged roster changed, a decision or verdict reversed, a
version lost) must be rejected, so a check that accepts everything fails. Usage:
scripts/check-code-traces
[--seeds N] [--jobs N] [--heap SIZE] [--fixtures]. Each parallel worker has
its own generated log modules. With --fixtures, the committed sample logs of
models/tla (RosterTrace, AdmitTrace, AuthorityTrace and CatalogueTrace, _good
and _bad) are rewritten from seed 1 and their modules regenerated, for
scripts/run-tlc.
"""

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
MODELS = ROOT / "models" / "tla"


def load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "scripts" / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def roster_mutant(lines):
    """The same run with the roster of its last checked step altered (a
    fast-forward writes no roster)."""
    events = [json.loads(line) for line in lines]
    last = [e for e in events if not e["vars"].get("ff", False)][-1]["vars"]["ros"]
    last["dev"][0] = 2 if last["dev"][0] != 2 else 1
    return [json.dumps(e, separators=(",", ":")) for e in events]


def admit_mutant(lines):
    """The same plan with its last decision reversed: an admitted key
    deferred, or a deferred one admitted."""
    events = [json.loads(line) for line in lines]
    last = [e for e in events if e["action"] in ("Admit", "Defer")][-1]
    last["action"] = "Defer" if last["action"] == "Admit" else "Admit"
    return [json.dumps(e, separators=(",", ":")) for e in events]


def authority_mutant(lines):
    """The same history with the verdict on its last commit reversed."""
    events = [json.loads(line) for line in lines]
    events[-1]["vars"]["acc"] = not events[-1]["vars"]["acc"]
    return [json.dumps(e, separators=(",", ":")) for e in events]


def catalogue_mutant(lines):
    """The same history with one version lost from the catalogue of its last
    accepted commit."""
    events = [json.loads(line) for line in lines]
    last = [e for e in events if e["vars"]["view"]][-1]["vars"]
    last["view"] = last["view"][:-1]
    return [json.dumps(e, separators=(",", ":")) for e in events]


# spec, cargo test target, file prefix, good and bad log modules, mutant.
SPECS = [("RosterTrace", "roster_trace", "roster", ("RosterCodeLog", "CodeLog"), ("RosterCodeBadLog", "BadLog"),
          roster_mutant),
         ("AdmitTrace", "admit_trace", "admit", ("AdmitCodeLog", "CodeLog"), ("AdmitCodeBadLog", "BadLog"),
          admit_mutant),
         ("AuthorityTrace", "authority_trace", "authority", ("AuthorityCodeLog", "CodeLog"),
          ("AuthorityCodeBadLog", "BadLog"), authority_mutant),
         ("CatalogueTrace", "catalogue_trace", "catalogue", ("CatalogueCodeLog", "CodeLog"),
          ("CatalogueCodeBadLog", "BadLog"), catalogue_mutant)]


def traces(target, seeds, out):
    env = dict(os.environ, PIGEON_TRACE_DIR=str(out), PIGEON_TRACE_SEEDS=str(seeds))
    subprocess.run(["cargo", "test", "--locked", "-q", "-p", "pigeon-core", "--features", "tla-trace",
                    "--test", target], cwd=ROOT, env=env, check=True)


def init_worker(tmp, local):
    # A worker alone rewrites its log modules. Sharing MODELS or changing
    # tlc.MODELS while another JVM is reading it can validate the wrong log.
    local.models = tmp / f"models-{threading.get_ident()}"
    shutil.copytree(MODELS, local.models)
    local.tla, local.tlc = load("trace-to-tla"), load("run-tlc")


def check_log(log, spec, good, bad, mutant, args, jar, local):
    lines = log.read_text().splitlines()
    for lines_of, (module, name), cfg in [
        (lines, good, f"{spec}_good"),
        (mutant(lines), bad, f"{spec}_bad"),
    ]:
        converted = local.tla.convert(lines_of, module, name)
        (local.models / f"{module}.tla").write_text(converted)
        if args.fixtures:
            (MODELS / f"{cfg}.ndjson").write_text("\n".join(lines_of) + "\n")
            (MODELS / f"{module}.tla").write_text(converted)
    results = []
    for cfg, want in [(f"{spec}_good", "trace:accepted"), (f"{spec}_bad", "trace:rejected")]:
        got, output = local.tlc.run(jar, cfg, spec, args.java, "1", args.heap, models=local.models)
        results.append((cfg, got, output, got.startswith(want)))
    return log.name, results


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--seeds", type=int, default=20)
    parser.add_argument("--fixtures", action="store_true")
    parser.add_argument("--java", default=os.environ.get("JAVA", "java"))
    parser.add_argument("--jobs", type=int, default=1, help="logs checked at once, each in its own model directory")
    parser.add_argument("--heap", help="maximum Java heap per worker, such as 2g")
    args = parser.parse_args()
    if args.jobs < 1 or args.seeds < 1:
        parser.error("--jobs and --seeds must be positive")
    tlc = load("run-tlc")
    jar = tlc.tlc_jar()
    failures = 0
    local = threading.local()
    with tempfile.TemporaryDirectory() as tmp, ThreadPoolExecutor(
        max_workers=args.jobs, initializer=init_worker, initargs=(Path(tmp), local)
    ) as pool:
        for spec, target, prefix, good, bad, mutant in SPECS:
            logs = Path(tmp) / "logs"
            traces(target, 1 if args.fixtures else args.seeds, logs)
            pending = [pool.submit(check_log, log, spec, good, bad, mutant, args, jar, local)
                       for log in sorted(logs.glob(f"{prefix}-*.ndjson"))]
            for future in as_completed(pending):
                name, results = future.result()
                for cfg, got, output, ok in results:
                    print(f"{'ok' if ok else 'FAIL':4} {name} {cfg}: {got}", flush=True)
                    if not ok:
                        failures += 1
                        print(tlc.excerpt(output), file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
