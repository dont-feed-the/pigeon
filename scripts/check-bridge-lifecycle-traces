#!/usr/bin/env python3
"""Replay real bridge lifecycle observations, including cross-restart identity.

Without a path run the socket-level lifecycle regression and corrupt its real
observations. With a path replay every lifecycle stream. Traces are prefixes:
they establish local identity/routing safety, not completion or roster removal.
"""
import argparse
import copy
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent


def load(name):
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / 'scripts' / name))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


tlc, encoder = load('run-tlc'), load('trace-to-tla')


class Refused(Exception):
    pass


def fields(value, names):
    if not isinstance(value, dict) or set(value) != set(names.split()):
        raise Refused(f'fields differ from {names}')


def normalize(events):
    if not events or events[0].get('action') != 'Start':
        raise Refused('missing initial persisted snapshot')
    tokens = {}
    def identity(value):
        if not isinstance(value, str) or not value:
            raise Refused('identity must be a nonempty string')
        return tokens.setdefault(value, len(tokens) + 1)
    def client(value):
        fields(value, 'id user device annex socket revoked')
        if type(value['revoked']) is not bool:
            raise Refused('revoked is not boolean')
        return {k: v if k == 'revoked' else identity(v) for k, v in value.items()}
    out = []
    for clock, event in enumerate(events, 1):
        fields(event, 'spec clock action vars')
        if event['spec'] != 'BridgeLifecycle' or type(event['clock']) is not int or event['clock'] != clock:
            raise Refused('unknown family or missing/reordered event')
        action, value = event['action'], event['vars']
        if action == 'Start':
            fields(value, 'clients controls')
            if not isinstance(value['clients'], list) or not isinstance(value['controls'], list):
                raise Refused('snapshot collections must be arrays')
            controls = []
            for control in value['controls']:
                fields(control, 'user socket')
                controls.append({k: identity(v) for k, v in control.items()})
            if len({c['user'] for c in controls}) != len(controls):
                raise Refused('duplicate account control')
            clients = [client(c) for c in value['clients']]
            if len({c['id'] for c in clients}) != len(clients):
                raise Refused('duplicate persisted client')
            value = dict(clients=clients, controls=controls)
        elif action == 'Register':
            value = client(value)
        elif action == 'Revoke':
            fields(value, 'id'); value = dict(id=identity(value['id']))
        elif action == 'Check':
            fields(value, 'id socket device annex shared accepted')
            if any(type(value[k]) is not bool for k in ('shared', 'accepted')):
                raise Refused('check flags must be boolean')
            value = {k: v if k in ('shared', 'accepted') else identity(v) for k, v in value.items()}
        elif action == 'Route':
            fields(value, 'id user socket'); value = {k: identity(v) for k, v in value.items()}
        elif action == 'Control':
            fields(value, 'user socket'); value = {k: identity(v) for k, v in value.items()}
        elif action == 'Remove':
            fields(value, 'id request')
            request = value['request']
            fields(request, 'type device')
            if request['type'] != 'RemoveDeviceId':
                raise Refused('native revocation did not use the exact-key operation')
            value = dict(id=identity(value['id']), device=identity(request['device']))
        else:
            raise Refused('unknown lifecycle action')
        out.append(dict(action=action, vars=value))
    return out


def check(events, java='java', diagnostics=True):
    events = normalize(events)
    with tempfile.TemporaryDirectory(prefix='bridge-lifecycle-tlc-') as tmp:
        work = Path(tmp)
        for name in ('BridgeLifecycle', 'BridgeLifecycleTrace'):
            shutil.copy(ROOT / 'models/tla' / (name + '.tla'), work)
        (work / 'BridgeLifecycleCodeLog.tla').write_text(
            '---- MODULE BridgeLifecycleCodeLog ----\nEXTENDS Naturals\nCodeLog == '
            + encoder.encode(events) + '\n====\n')
        (work / 'Observed.cfg').write_text('''CONSTANT WeakRevocation = FALSE
TraceLog <- CodeLog
SPECIFICATION TraceSpec
INVARIANT TraceNotConsumed
CHECK_DEADLOCK FALSE
''')
        verdict, output = tlc.run(tlc.tlc_jar(), 'Observed', 'BridgeLifecycleTrace', java, '1', '1g', models=work)
        if verdict != 'trace:accepted' and diagnostics:
            print(tlc.excerpt(output), file=sys.stderr)
        return verdict


def mutations(events, java):
    mutants = {}
    route = next(i for i, e in enumerate(events) if e['action'] == 'Route')
    m = copy.deepcopy(events); m[route]['vars']['socket'] += '-wrong'; mutants['wrong client socket'] = m
    m = copy.deepcopy(events); m[route]['vars']['user'] += '-other'; mutants['cross-account route'] = m
    checked = next(i for i, e in enumerate(events) if e['action'] == 'Check' and e['vars']['accepted'])
    m = copy.deepcopy(events); m[checked]['vars']['device'] += '-wrong'; mutants['changed signing identity'] = m
    m = copy.deepcopy(events); m[checked]['vars']['annex'] += '-wrong'; mutants['changed annex identity'] = m
    m = copy.deepcopy(events); m[checked]['vars']['shared'] = False; mutants['unshared daemon accepted'] = m
    control = next(i for i, e in enumerate(events) if e['action'] == 'Control')
    m = copy.deepcopy(events); m[control]['vars']['socket'] = events[route]['vars']['socket']; mutants['account action on client'] = m
    start = [i for i, e in enumerate(events) if e['action'] == 'Start'][-1]
    m = copy.deepcopy(events)
    revoked = next(c for c in m[start]['vars']['clients'] if c['revoked'])
    revoked['revoked'] = False; mutants['revocation lost on restart'] = m
    m = copy.deepcopy(events); m[start]['vars']['clients'][0]['device'] += '-new'; mutants['identity lost on restart'] = m
    removal = next(i for i, e in enumerate(events) if e['action'] == 'Remove')
    m = copy.deepcopy(events); m[removal]['vars']['request']['device'] += '-sibling'; mutants['native removal targets another key'] = m
    m = copy.deepcopy(events)
    clients = m[0]['vars']['clients']; clients[1]['device'] = clients[0]['device']; mutants['two clients share signer'] = m
    m = copy.deepcopy(events)
    clients = m[0]['vars']['clients']; clients[1]['annex'] = clients[0]['annex']; mutants['two clients share annex'] = m
    # Move an actual previously admitted route behind the persisted revoke.
    m = copy.deepcopy(events)
    rev = next(i for i, e in enumerate(m) if e['action'] == 'Revoke')
    old = next(e for e in m[:rev] if e['action'] == 'Route' and e['vars']['id'] == m[rev]['vars']['id'])
    m.insert(rev + 1, copy.deepcopy(old))
    for i, e in enumerate(m, 1):
        e['clock'] = i
    mutants['queued request uses stale authorization'] = m
    for name, mutant in mutants.items():
        verdict = check(mutant, java, False)
        if not verdict.startswith('trace:rejected:'):
            raise Refused(f'{name}: expected TLC rejection, got {verdict}')
        print(f'ok   rejects {name}', flush=True)
    for name, mutant in [('missing event', events[:route] + events[route+1:]), ('empty stream', [])]:
        try:
            normalize(mutant)
        except Refused:
            print(f'ok   refuses {name}', flush=True)
        else:
            raise Refused(f'accepted {name}')


def replay(root, java, regression=False):
    streams = []
    for path in sorted(root.rglob('lifecycle-*.ndjson')):
        events = [json.loads(line, object_pairs_hook=encoder.pairs) for line in path.read_text().splitlines()]
        verdict = check(events, java)
        if verdict != 'trace:accepted':
            raise Refused(f'{path.name}: {verdict}')
        streams.append(events)
    if not streams:
        raise Refused('no lifecycle traces')
    print(f'ok   TLC accepts {len(streams)} real lifecycle streams', flush=True)
    if regression:
        if len(streams) != 5:
            raise Refused(f'expected all 5 regression lifecycle streams, found {len(streams)}')
        events = next((s for s in streams if sum(e['action'] == 'Start' for e in s) >= 2
                       and any(e['action'] == 'Control' for e in s)), None)
        if events is None or not any(e['action'] == 'Revoke' for e in events):
            raise Refused('missing restart, control routing or persisted revocation coverage')
        mutations(events, java)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('path', nargs='?', type=Path)
    parser.add_argument('--java', default=os.environ.get('JAVA', 'java'))
    args = parser.parse_args()
    if args.path:
        replay(args.path, args.java)
    else:
        with tempfile.TemporaryDirectory(prefix='bridge-lifecycle-regression-') as tmp:
            env = dict(os.environ, PIGEON_TRACE='1', PIGEON_TRACE_DIR=tmp)
            subprocess.run(['cargo', 'test', '--locked', '-p', 'pigeon-bridge', '--features', 'tla-trace',
                            'lifecycle_tests::'], cwd=ROOT, env=env, check=True)
            replay(Path(tmp), args.java, True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (Refused, encoder.Refused, KeyError, TypeError, ValueError, OSError) as error:
        sys.exit(f'FAIL {error}')
