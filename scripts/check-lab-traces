#!/usr/bin/env python3
"""Check the merged trace logs of the slice's scenarios against TLA+ (ADR 0008, 13 §13.12).

`pigeon-lab run` writes OUT/<scenario>/trace.ndjson, every device's events in
Lamport-clock order. For each specification of a trace that has a trace
specification (SPECS), its events become a TLA+ module through
scripts/trace-to-tla and TLC must accept them. A specification without one,
or whose events lack the variables its trace specification reads (FIELDS),
fails with what is missing. Unknown or incomplete trace families never pass.
Usage: scripts/check-lab-traces [--java JAVA] OUT
"""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import shutil
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
MODELS = ROOT / "models" / "tla"
# spec of the events: trace specification, its log module and name, config.
SPECS = {
    "StorageBoundary": ("StorageTrace", ("StorageCodeLog", "CodeLog"), "StorageTrace_good"),
}
# Variables read by the generic trace specifications. Filesystem and
# roster observations use their dedicated adapters below.
FIELDS = {
    "StorageBoundary": {
        "Capture": {"pending", "live", "saved", "captured"},
        "Archive": {"saved", "present"},
        "Release": {"saved", "present", "written", "released"},
        "Retention": {"expected", "enumerated"},
    },
}


def lacking(spec, lines):
    """The variables the events of `spec` lack, as `Action: a, b` items."""
    out = set()
    for line in lines:
        event = json.loads(line)
        need = FIELDS.get(spec, {}).get(event["action"], set())
        missing = need - set(event.get("vars", {}))
        if missing:
            out.add(f"{event['action']} lacks {', '.join(sorted(missing))}")
    return sorted(out)


def load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "scripts" / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("out")
    parser.add_argument("--java", default=os.environ.get("JAVA", "java"))
    parser.add_argument("--require", action="append", default=[], help="fail unless this specification was checked")
    args = parser.parse_args()
    tla, tlc = load("trace-to-tla"), load("run-tlc")
    install, roster = load("check-install-traces"), load("check-roster-traces")
    jar = tlc.tlc_jar()
    failures, unchecked, partial, checked = 0, set(), {}, set()
    with tempfile.TemporaryDirectory() as tmp:
        work = Path(tmp) / "models"
        shutil.copytree(MODELS, work)
        tlc.MODELS = work
        logs = sorted(Path(args.out).rglob("trace.ndjson"))
        if not logs:
            logs = sorted(Path(args.out).rglob("*.ndjson"))
        if not logs:
            print("FAIL no trace logs", flush=True)
            failures += 1
        for log in logs:
            by_spec = {}
            clocks = {}
            try:
                for line in log.read_text().splitlines():
                    if not line.strip():
                        continue
                    event = json.loads(line, object_pairs_hook=tla.pairs)
                    for field in ("spec", "device", "clock", "action", "vars"):
                        if field not in event:
                            raise ValueError(f"missing {field}")
                    device, clock = event["device"], event["clock"]
                    if type(clock) is not int or clock != clocks.get(device, 0) + 1:
                        raise ValueError("missing, repeated or out-of-order trace clock")
                    clocks[device] = clock
                    by_spec.setdefault(event["spec"], []).append(line)
                if not by_spec:
                    raise ValueError("empty trace log")
            except (ValueError, KeyError, TypeError, tla.Refused) as error:
                print(f"FAIL {log}: {error}", flush=True)
                failures += 1
                continue
            filesystem = set(by_spec) & install.FILESYSTEM_SPECS
            if filesystem:
                groups = {}
                for spec in filesystem:
                    for line in by_spec.pop(spec):
                        e = json.loads(line)
                        try:
                            v = e["vars"]
                            groups.setdefault((e["device"], v["group"], v["path"]), []).append(e)
                        except KeyError as error:
                            print(f"FAIL {log}: missing filesystem identity {error}", flush=True)
                            failures += 1
                complete = bool(groups)
                for identity, events in sorted(groups.items()):
                    try:
                        verdict = install.check(sorted(events, key=lambda e: e["clock"]), args.java, 4)
                        ok = verdict == "trace:accepted"
                        print(f"{'ok' if ok else 'FAIL'} {log.parent.name} filesystem {identity[-1]}: {verdict}", flush=True)
                    except (install.Refused, KeyError, ValueError, TypeError) as error:
                        ok = False
                        print(f"FAIL {log}: filesystem: {error}", flush=True)
                    failures += not ok
                    complete &= ok
                if complete:
                    checked.update(filesystem)
            if "Roster" in by_spec:
                try:
                    verdict = roster.check([json.loads(line) for line in by_spec.pop("Roster")], args.java)
                    ok = verdict == "trace:accepted"
                    print(f"{'ok' if ok else 'FAIL'} {log.parent.name} Roster: {verdict}", flush=True)
                except (roster.Refused, KeyError, ValueError, TypeError) as error:
                    ok = False
                    print(f"FAIL {log}: Roster: {error}", flush=True)
                failures += not ok
                if ok:
                    checked.add("Roster")
            for spec, lines in sorted(by_spec.items()):
                if spec not in SPECS:
                    unchecked.add(spec)
                    failures += 1
                    continue
                missing = lacking(spec, lines)
                if missing:
                    partial.setdefault(spec, set()).update(missing)
                    failures += 1
                    continue
                trace_spec, (module, name), cfg = SPECS[spec]
                try:
                    (work / f"{module}.tla").write_text(tla.convert(lines, module, name))
                except tla.Refused as error:
                    print(f"FAIL {log}: {spec}: {error}", flush=True)
                    failures += 1
                    continue
                got, output = tlc.run(jar, cfg, trace_spec, args.java, "1", None)
                ok = got.startswith("trace:accepted")
                print(f"{'ok' if ok else 'FAIL':4} {log.parent.name} {spec}: {len(lines)} events: {got}", flush=True)
                if not ok:
                    failures += 1
                    print(tlc.excerpt(output), file=sys.stderr)
                else:
                    checked.add(spec)
    for spec in sorted(unchecked):
        print(f"FAIL unsupported trace specification: {spec}", flush=True)
    for spec, missing in sorted(partial.items()):
        print(f"FAIL incomplete trace specification {spec}: {'; '.join(sorted(missing))}", flush=True)
    for spec in sorted(set(args.require)):
        if spec not in checked or spec in partial or spec in unchecked:
            print(f"FAIL required trace specification was not checked: {spec}", flush=True)
            failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
