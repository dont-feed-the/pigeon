#!/usr/bin/env python3
"""Turn a merged NDJSON trace into a TLA+ module that TLC 1.7.4 reads (spec 13 §13.3).

Each line is one event of 12 §12.3: an object with spec, device, clock, action
and vars. The module defines NAME == << event, ... >>, each event a record.
Integers, booleans, printable ASCII strings, arrays (as tuples) and non-empty
objects (as records, keys TLA+ identifiers) are encoded; anything else (null,
a fraction, a control or non-ASCII character, a reserved word as a key) is
refused with its line, never approximated. Lines must be in the Lamport order
of the merge: (clock, device) never decreasing.

Usage: scripts/trace-to-tla LOG.ndjson MODULE [--name NAME] [--out DIR]
       scripts/trace-to-tla --check   (fixtures up to date, refusals refused)
"""

import argparse
import json
import re
import sys
from pathlib import Path

MODELS = Path(__file__).resolve().parent.parent / "models" / "tla"
# (log, module, definition): generated modules kept in models/tla, checked by --check.
FIXTURES = [("TraceSample_good.ndjson", "TraceSampleGoodLog", "GoodLog"),
            ("TraceSample_bad.ndjson", "TraceSampleBadLog", "BadLog"),
            ("RosterTrace_good.ndjson", "RosterCodeLog", "CodeLog"),
            ("RosterTrace_bad.ndjson", "RosterCodeBadLog", "BadLog"),
            ("AdmitTrace_good.ndjson", "AdmitCodeLog", "CodeLog"),
            ("AdmitTrace_bad.ndjson", "AdmitCodeBadLog", "BadLog"),
            ("AuthorityTrace_good.ndjson", "AuthorityCodeLog", "CodeLog"),
            ("AuthorityTrace_bad.ndjson", "AuthorityCodeBadLog", "BadLog"),
            ("CatalogueTrace_good.ndjson", "CatalogueCodeLog", "CodeLog"),
            ("CatalogueTrace_bad.ndjson", "CatalogueCodeBadLog", "BadLog"),
            ("StorageTrace_good.ndjson", "StorageCodeLog", "CodeLog"),
            ("StorageTrace_bad.ndjson", "StorageCodeBadLog", "BadLog")]
IDENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
RESERVED = set("""ASSUME ASSUMPTION AXIOM CASE CHOOSE CONSTANT CONSTANTS DOMAIN ELSE
    ENABLED EXCEPT EXTENDS IF IN INSTANCE LET LOCAL MODULE OTHER SF_ SUBSET THEN
    THEOREM UNCHANGED UNION VARIABLE VARIABLES WF_ WITH TRUE FALSE BOOLEAN STRING
    LAMBDA ACTION ASSUMPTION COROLLARY LEMMA PROOF PROPOSITION QED""".split())


class Refused(Exception):
    pass


class Number:
    """A JSON number that is not an integer, kept only to be refused."""

    def __init__(self, text):
        self.text = text


def pairs(items):
    """A JSON object as a dict, refusing a repeated key."""
    keys = [key for key, _ in items]
    if len(set(keys)) != len(keys):
        raise Refused(f"repeated key in {keys}")
    return dict(items)


def encode(value):
    """The TLA+ expression of one JSON value, or Refused."""
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        if any(not 0x20 <= ord(ch) <= 0x7E for ch in value):
            raise Refused(f"string {value!r} holds a control or non-ASCII character")
        return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if isinstance(value, list):
        return "<<" + ", ".join(encode(item) for item in value) + ">>"
    if isinstance(value, dict):
        if not value:
            raise Refused("an empty object has no TLA+ record")
        for key in value:
            if not IDENT.match(key) or key in RESERVED or key.startswith(("WF_", "SF_")):
                raise Refused(f"key {key!r} is not a TLA+ field name")
        return "[" + ", ".join(f"{key} |-> {encode(item)}" for key, item in value.items()) + "]"
    if isinstance(value, Number):
        raise Refused(f"number {value.text} is not an integer")
    raise Refused(f"value {value!r} has no encoding")


def convert(lines, module, name):
    """The text of the module for the NDJSON lines, or Refused naming the line."""
    if not IDENT.match(module) or not IDENT.match(name):
        raise Refused(f"module {module!r} or name {name!r} is not an identifier")
    events, last = [], None
    for number, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            event = json.loads(line, parse_float=Number, parse_constant=Number,
                               object_pairs_hook=pairs)
            if not isinstance(event, dict):
                raise Refused("an event is an object")
            for field in ("spec", "device", "clock", "action", "vars"):
                if field not in event:
                    raise Refused(f"missing {field}")
            order = (event["clock"], event["device"])
            if not isinstance(order[0], int) or isinstance(order[0], bool):
                raise Refused("clock is not an integer")
            if last is not None and order < last:
                raise Refused(f"(clock, device) {order} comes before {last}: not merged")
            last = order
            events.append(encode(event))
        except json.JSONDecodeError as error:
            raise Refused(f"line {number}: not JSON ({error.msg})") from None
        except Refused as error:
            raise Refused(f"line {number}: {error}") from None
    body = ",\n  ".join(events)
    return (f"---- MODULE {module} ----\n"
            f"\\* Generated by scripts/trace-to-tla; do not edit (spec 13 §13.3).\n"
            f"EXTENDS Integers\n"
            f"{name} == <<\n  {body}\n  >>\n====\n")


# Lines that must be refused, each for the reason in its comment.
REFUSALS = [
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":null}}',  # unknown
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":1.5}}',  # fraction
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":1e3}}',  # exponent
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":NaN}}',  # constant
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":"a\\nb"}}',  # control
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":"\\u00e9"}}',  # non-ASCII
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"IF":1}}',  # reserved
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"a-b":1}}',  # not an identifier
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{}}',  # empty record
    '{"spec":"S","device":"d","clock":1,"action":"A","vars":{"x":1,"x":2}}',  # repeated key
    '{"spec":"S","device":"d","clock":1,"action":"A"}',  # missing vars
    '{"spec":"S","device":"d","clock":"1","action":"A","vars":{"x":1}}',  # clock text
    '[1, 2]',  # not an object
    '{"spec":"S","device":"d",',  # not JSON
]
ORDERED = ['{"spec":"S","device":"b","clock":2,"action":"A","vars":{"x":1}}',
           '{"spec":"S","device":"a","clock":2,"action":"A","vars":{"x":1}}']


def check():
    """Fail unless every fixture module is up to date and every refusal refuses."""
    failures = 0
    for log, module, name in FIXTURES:
        text = convert((MODELS / log).read_text().splitlines(), module, name)
        if (MODELS / f"{module}.tla").read_text() != text:
            print(f"FAIL {module}.tla differs from scripts/trace-to-tla {log}")
            failures += 1
    for line in [*REFUSALS, "\n".join(ORDERED)]:
        try:
            convert(line.splitlines(), "M", "L")
        except Refused as error:
            print(f"ok   refused: {error}")
        else:
            print(f"FAIL accepted: {line}")
            failures += 1
    return 1 if failures else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("log", nargs="?")
    parser.add_argument("module", nargs="?")
    parser.add_argument("--name", default="TraceLog")
    parser.add_argument("--out", default=".")
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    if arguments.check:
        return check()
    if not arguments.log or not arguments.module:
        parser.error("LOG and MODULE are required")
    try:
        text = convert(Path(arguments.log).read_text().splitlines(), arguments.module, arguments.name)
    except Refused as error:
        print(f"{arguments.log}: {error}", file=sys.stderr)
        return 1
    (Path(arguments.out) / f"{arguments.module}.tla").write_text(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
