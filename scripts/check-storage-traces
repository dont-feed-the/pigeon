#!/usr/bin/env python3
"""Check actual capture/recovery/history boundaries against StorageTrace.

The install regressions observe the real filesystem and emit all four
required actions. Each observation must pass TLC; corrupting each action
must fail. Missing logs, fields, actions or checker coverage fail too.
This is boundary conformance, not a full proof of the filesystem driver.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REQUIRED = {"Capture", "Archive", "Release", "Retention"}


def checked(out, java):
    """Run the same mandatory trace checker used for lab observations."""
    return subprocess.run(
        [sys.executable, str(ROOT / "scripts/check-lab-traces"), str(out),
         "--java", java, "--require", "StorageBoundary"],
        cwd=ROOT, capture_output=True, text=True,
    )


def mutant(event):
    """Break the observed guarantee for one action, leaving others intact."""
    event = json.loads(json.dumps(event))
    values = event["vars"]
    if event["action"] == "Capture":
        values.update(pending=True, captured=False, live="overwritten")
    elif event["action"] in {"Archive", "Release"}:
        values["present"] = []
    else:
        values["enumerated"] = []
    return event


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--java", default=os.environ.get("JAVA", "java"))
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="pigeon-storage-traces-") as tmp:
        out = Path(tmp)
        env = dict(os.environ, PIGEON_STORAGE_TRACE_DIR=tmp, PIGEON_REQUIRE_GIT_ANNEX="1")
        subprocess.run(
            ["cargo", "test", "--locked", "-p", "pigeond", "--test", "install",
             "--", "--test-threads=1"], cwd=ROOT, env=env, check=True,
        )
        logs = {p.parent.name: p for p in out.glob("*/trace.ndjson")}
        if set(logs) != REQUIRED:
            sys.exit(f"missing or unexpected storage traces: {set(logs)}; expected {REQUIRED}")
        good = checked(out, args.java)
        print(good.stdout, end="", flush=True)
        if good.returncode:
            sys.exit(good.stderr or "storage traces were not accepted")
        for action, path in sorted(logs.items()):
            original = path.read_text()
            events = [json.loads(line) for line in original.splitlines()]
            events[-1] = mutant(events[-1])
            path.write_text("".join(json.dumps(e) + "\n" for e in events))
            bad = checked(out, args.java)
            path.write_text(original)
            if bad.returncode == 0 or "trace:rejected:" not in bad.stdout:
                sys.exit(f"FAIL {action}: the checker did not reject the corrupted observation\n{bad.stdout}{bad.stderr}")
            print(f"ok   {action}: corrupted observation rejected", flush=True)
        # Other valid runs of the same spec must not mask missing fields.
        path = logs["Capture"]
        original = path.read_text()
        event = json.loads(original.splitlines()[0])
        del event["vars"]["pending"]
        path.write_text(json.dumps(event) + "\n")
        missing = checked(out, args.java)
        path.write_text(original)
        if missing.returncode == 0 or "required trace specification was not checked" not in missing.stdout:
            sys.exit("FAIL missing fields were masked by another checked run")
        print("ok   missing fields in a required trace rejected", flush=True)
        # A checked specification with no logged run must never pass.
        for path in logs.values():
            path.unlink()
        empty = checked(out, args.java)
        if empty.returncode == 0 or "required trace specification was not checked" not in empty.stdout:
            sys.exit("FAIL missing required storage observations were accepted")
        print("ok   missing required storage observations rejected", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
