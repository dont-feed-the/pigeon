#!/usr/bin/env python3
"""Check parameterized TLAPS proofs, their configuration coverage and mutants.

Use --benchmark to compare TLC and Apalache as well. Logs and timings go to
target/formal-proofs by default. No proof fingerprints are reused. Tools are
pinned and downloaded into ~/.cache/pigeon; --tlapm and --apalache select an
already installed copy of the same version. Linux x86_64 is required by the
TLAPS binary distribution. The proofs themselves are platform independent.
"""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
MODELS = ROOT / "models" / "tla"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pigeon"
TLAPS_VERSION = "1.5.0"
TLAPS_SHA = "ebb7a3f271bdb564f74cb0a2767ef7b9ff7045621a9be7c50d363a03c2e6f08a"
TLAPS_URL = ("https://github.com/tlaplus/tlapm/releases/download/202210041448/"
             "tlaps-1.5.0-x86_64-linux-gnu-inst.bin")
APALACHE_VERSION = "0.62.4"
APALACHE_SHA = "b781b53bba32fac14ac2e02b0332e1dc2edc64cb7b850c0608d8142cc7aa2ef4"
APALACHE_URL = ("https://github.com/apalache-mc/apalache/releases/download/"
                "v0.62.4/apalache-0.62.4.tgz")
PROOFS = {"CaptureTransactionProof": ("CaptureTransaction_safe",),
          "AnnexDropProof": ("AnnexDrop_design4",),
          "PurgeProof": ("Purge_full3",),
          "CustodyTokensProof": ("T_n42o4", "T_n31o5", "T_n32o5"),
          "AuthorityDecidersProof": ("Authority_mixed",)}
PROOF_MODELS = {"AuthorityDecidersProof": "Authority"}
UNCONDITIONAL = {"AuthorityDecidersProof"}


def load_tlc():
    loader = importlib.machinery.SourceFileLoader("proof_tlc", str(ROOT / "scripts/run-tlc"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def download(name, url, digest):
    CACHE.mkdir(parents=True, exist_ok=True)
    path = CACHE / name
    if not path.exists():
        with tempfile.NamedTemporaryFile(dir=CACHE, delete=False) as partial:
            temp = Path(partial.name)
        try:
            urllib.request.urlretrieve(url, temp)
            if hashlib.sha256(temp.read_bytes()).hexdigest() != digest:
                raise RuntimeError(f"{url}: downloaded SHA-256 differs from pin")
            temp.replace(path)
        finally:
            temp.unlink(missing_ok=True)
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise RuntimeError(f"{path}: cached SHA-256 differs from pin")
    return path


def tlapm_binary(explicit, out):
    if explicit:
        return Path(explicit).resolve()
    if platform.system() != "Linux" or platform.machine() not in ("x86_64", "AMD64"):
        raise RuntimeError("the pinned TLAPS distribution needs Linux x86_64; use --tlapm")
    installer = download("tlaps-1.5.0-inst.bin", TLAPS_URL, TLAPS_SHA)
    prefix = CACHE / "tlaps-1.5.0"
    binary = prefix / "bin/tlapm"
    stamp = prefix / ".pigeon-installed"
    if not stamp.exists() or stamp.read_text().strip() != TLAPS_SHA:
        installer.chmod(0o700)
        print("Installing TLAPS (including its Isabelle self-test)...", flush=True)
        done = subprocess.run([str(installer), "-d", str(prefix)], capture_output=True, text=True)
        (out / "tlaps-install.log").write_text(done.stdout + done.stderr)
        if done.returncode:
            raise RuntimeError(f"TLAPS installation failed; see {out / 'tlaps-install.log'}")
        stamp.write_text(TLAPS_SHA + "\n")
    return binary


def apalache_binary(explicit):
    if explicit:
        return Path(explicit).resolve()
    archive = download("apalache-0.62.4.tgz", APALACHE_URL, APALACHE_SHA)
    binary = CACHE / "apalache-0.62.4/bin/apalache-mc"
    if not binary.exists():
        with tarfile.open(archive) as tar:
            tar.extractall(CACHE, filter="data")
    return binary


def version(binary, flag, expected):
    done = subprocess.run([str(binary), flag], capture_output=True, text=True, check=True)
    if done.stdout.strip() != expected:
        raise RuntimeError(f"{binary}: expected {expected}, got {done.stdout.strip()!r}")


def copy_models(work):
    for path in MODELS.glob("*.tla"):
        shutil.copy2(path, work / path.name)
    for path in MODELS.glob("*.cfg"):
        shutil.copy2(path, work / path.name)


class Checks:
    def __init__(self, out, tlapm, java):
        self.out, self.tlapm, self.java = out, tlapm, java
        self.library = Path(subprocess.check_output([str(tlapm), "--where"], text=True).strip())
        self.jar = load_tlc().tlc_jar()
        self.results = []
        rows = {config: (module, group) for config, module, group, _ in load_tlc().expectations()}
        for proof, configs in PROOFS.items():
            for config in configs:
                if rows.get(config, (None,))[0] != PROOF_MODELS.get(proof, proof.removesuffix("Proof")):
                    raise RuntimeError(f"{config}: proof/config module mapping changed")
        covered = {config for configs in PROOFS.values() for config in configs}
        if {config for config, (_, group) in rows.items() if group == "audit"} - covered:
            raise RuntimeError("an audit row has no checked parameterized proof")

    def run(self, name, command, work, timeout=120):
        start = time.monotonic()
        done = subprocess.run(command, cwd=work, capture_output=True, text=True, timeout=timeout)
        seconds = time.monotonic() - start
        output = done.stdout + done.stderr
        (self.out / f"{name}.log").write_text(output)
        self.results.append({"name": name, "seconds": round(seconds, 3),
                             "exit_code": done.returncode, "command": command})
        print(f"{name}: exit {done.returncode}, {seconds:.3f} s", flush=True)
        return done.returncode, output

    def proof(self, work, module, name=None, reject=False, bridge=None):
        source = (work / f"{module}.tla").read_text()
        if re.search(r"\b(OMITTED|PROOF\s+OMITTED)\b", source):
            raise RuntimeError(f"{module}: an omitted proof is not evidence")
        if not re.search(r"^THEOREM Safety\s*==", source, re.M):
            raise RuntimeError(f"{module}: missing Safety theorem")
        code, output = self.run(name or module, [str(self.tlapm), "--nofp", "--threads", "2",
                                                f"{bridge or module}.tla"], work)
        if reject:
            # Syntax errors, missing tools and timeouts do not count as a mutant
            # detected. TLAPS must report an actual unproved obligation.
            if re.search(r"Resource temporarily unavailable|pthread_create|"
                         r"unable to create native thread|cannot fork|failed to spawn|"
                         r"No such file or directory|command not found|OutOfMemoryError",
                         output, re.I):
                raise RuntimeError(f"{name}: infrastructure failure is not mutation evidence")
            if code != 3 or not re.search(r"\[ERROR\]: \d+/\d+ obligations failed", output):
                raise RuntimeError(f"{name}: expected an unproved obligation; inspect its log")
        else:
            target = bridge or module
            summary = re.search(rf'File "\./{target}\.tla"[^\n]*:\n'
                                r'\[INFO\]: All ([1-9]\d*) obligations proved\.', output)
            if code or not summary or re.search(r"\b(omitted|unproved|failed)\b", output, re.I):
                raise RuntimeError(f"{module}: proof incomplete; inspect its log")

    def configuration_theorem(self, work, module, config):
        cfg = (work / f"{config}.cfg").read_text()
        cfg = re.sub(r"\\\*[^\n]*", "", cfg)
        if ("<-" in cfg or re.search(r"^\s*(CONSTRAINTS?|ACTION_CONSTRAINTS?|"
                                      r"SYMMETRY|VIEW|INIT|NEXT|PROPERT(Y|IES))\b", cfg, re.M)):
            raise RuntimeError(f"{config}: unsupported coverage configuration directive")
        if not re.search(r"^CHECK_DEADLOCK FALSE\s*$", cfg, re.M):
            raise RuntimeError(f"{config}: the proof does not establish absence of deadlock")
        clauses = re.findall(r"^[ \t]*INVARIANTS?\b(.*?)"
                             r"(?=^[ \t]*(?:INVARIANTS?|CONSTANTS?|SPECIFICATION|CHECK_DEADLOCK)\b|\Z)",
                             cfg, re.M | re.S)
        if not clauses or any(not re.fullmatch(r"\s*[A-Za-z_][A-Za-z_0-9]*"
                                               r"(?:\s+[A-Za-z_][A-Za-z_0-9]*)*\s*", clause)
                              for clause in clauses):
            raise RuntimeError(f"{config}: expected named safety invariants")
        invariants = [name for clause in clauses for name in clause.split()]
        # Prove that the actual configured properties follow from Safety.
        # Checking them in just the initial state would miss a newly added
        # invariant that fails only after some transitions.
        bridge = module + "Configuration"
        conjunction = " /\\ ".join(invariants)
        premise = "" if module in UNCONDITIONAL else "Spec => "
        (work / f"{bridge}.tla").write_text(
            f"---- MODULE {bridge} ----\nEXTENDS {module}\n"
            f"THEOREM ConfigurationSafety == {premise}[]({conjunction})\n"
            "BY Safety, PTL\n====\n")
        return bridge

    def coverage(self, work, module, config, name=None, reject=False):
        # Check the actual cfg constants against the very same expression
        # assumed by the proof, using TLC's constant evaluation. No Python copy
        # of those assumptions can drift away from the theorem.
        cfg = (work / f"{config}.cfg").read_text()
        cfg, count = re.subn(r"^SPECIFICATION Spec\s*$",
                             "INIT Init\nNEXT ProofCoverageNext", cfg, flags=re.M)
        if count != 1:
            raise RuntimeError(f"{config}: coverage requires SPECIFICATION Spec")
        (work / "ProofCoverage.tla").write_text(
            f"---- MODULE ProofCoverage ----\nEXTENDS {module}\n"
            "ProofCoverageNext == UNCHANGED vars\n====\n")
        (work / "ProofCoverage.cfg").write_text(cfg + "\nINVARIANT ProofParameters\n")
        command = [self.java, "-Xmx1g", "-XX:+UseParallelGC", f"-Djava.io.tmpdir={work}",
                   f"-DTLA-Library={self.library}", "-cp", str(self.jar), "tlc2.TLC",
                   "-workers", "1", "-metadir", str(work / "states"),
                   "-config", "ProofCoverage.cfg", "ProofCoverage"]
        code, output = self.run(name or f"coverage-{config}", command, work)
        if reject:
            if not code or "Error: The invariant of ProofParameters is equal to FALSE" not in output:
                raise RuntimeError(f"{name}: expected a false proof assumption; inspect its log")
        elif (code or "Model checking completed. No error has been found." not in output
              or not re.search(r"\b[1-9]\d* distinct states found\b", output)):
            raise RuntimeError(f"{config}: not covered by {module}; inspect its log")

    def positives(self):
        for module, configs in PROOFS.items():
            with tempfile.TemporaryDirectory() as temp:
                work = Path(temp)
                copy_models(work)
                # TLAPS treats imported theorems as established; checking only
                # an extending bridge reports zero obligations for its import.
                # Prove the root itself first, then prove the configured claim.
                self.proof(work, module)
                for config in configs:
                    bridge = self.configuration_theorem(work, module, config)
                    self.proof(work, module, name=f"properties-{config}", bridge=bridge)
                    self.coverage(work, module, config)

    def mutants(self):
        cases = [
            ("capture-no-guard", "CaptureTransaction", "CaptureTransactionProof",
             'phase = "idle" \\/ "guard" \\in Off', "TRUE"),
            ("capture-no-commit", "CaptureTransaction", "CaptureTransactionProof",
             "commits' = commits \\cup {pending}", "commits' = commits"),
            ("drop-no-copies", "AnnexDrop", "AnnexDropProof",
             "Cardinality(proof[d]) >= K", "TRUE"),
            ("drop-no-shared-guard", "AnnexDrop", "AnnexDropProof",
             "shared[d] = {}", "TRUE"),
            ("purge-no-history-merge", "Purge", "PurgeProof",
             "/\\ \\A x \\in Custodians : (seal[x].r1 => knowsR1[d])\n"
             "                                                     /\\ (seal[x].cancel => knowsCancel[d])",
             "/\\ TRUE"),
            ("purge-no-wait", "Purge", "PurgeProof", "now >= seen[c] + R", "TRUE"),
            ("purge-unwanted-fetch", "Purge", "PurgeProof", "/\\ Wants(d)", "/\\ TRUE"),
            ("tokens-stale-reply", "CustodyTokens", "CustodyTokensProof",
             "r.id = offering[n].id", "TRUE"),
            ("tokens-idempotent-ack", "CustodyTokens", "CustodyTokensProof",
             "IdempotentAck /\\ o.t \\in tok[m]", "o.t \\in tok[m]"),
            ("authority-no-decider-guard", "Authority", "AuthorityDecidersProof",
             'D == {u \\in Persons : \\A q \\in diff : AllowedC(u, q, old(q), new(q), Ro, S)}',
             "D == Persons"),
        ]
        for name, target, proof, old, new in cases:
            with tempfile.TemporaryDirectory() as temp:
                work = Path(temp)
                copy_models(work)
                path = work / f"{target}.tla"
                text = path.read_text()
                if text.count(old) != 1:
                    raise RuntimeError(f"{name}: mutation site changed")
                path.write_text(text.replace(old, new))
                self.proof(work, proof, name, reject=True)
                if target == "Purge":
                    # An unproved auxiliary invariant alone need not imply a
                    # broken protocol: require a counterexample to actual safety.
                    self.purge_tlc(work, name + "-counterexample", reject=True)
                if target == "CustodyTokens":
                    self.tokens_tlc(work, name + "-counterexample", reject=True)
                if target == "Authority":
                    self.authority_tlc(work, name + "-counterexample", reject=True)
        with tempfile.TemporaryDirectory() as temp:
            work = Path(temp)
            copy_models(work)
            path = work / "CaptureTransaction.tla"
            path.write_text(path.read_text().replace(
                "=============================================================================",
                "IndexNeverMoves == idx = 1\n============================================================================="))
            cfg = work / "CaptureTransaction_safe.cfg"
            cfg.write_text(cfg.read_text().replace("INVARIANT CapturedBeforeDisplacement",
                "INVARIANTS CapturedBeforeDisplacement\n  IndexNeverMoves"))
            bridge = self.configuration_theorem(work, "CaptureTransactionProof", "CaptureTransaction_safe")
            self.proof(work, "CaptureTransactionProof", "unproved-config-invariant", reject=True, bridge=bridge)
        for constant, old, new in [("Expiry", "FALSE", "TRUE"),
                                    ("Check", '"safe"', '"p2p"'),
                                    ("Trusted", "{}", "{1}"),
                                    ("LogOnly", "FALSE", "TRUE")]:
            with tempfile.TemporaryDirectory() as temp:
                work = Path(temp)
                copy_models(work)
                cfg = work / "AnnexDrop_design4.cfg"
                text, count = re.subn(rf"\b{constant} = {re.escape(old)}",
                                      f"{constant} = {new}", cfg.read_text())
                if count != 1:
                    raise RuntimeError(f"{constant}: coverage mutation site changed")
                cfg.write_text(text)
                self.coverage(work, "AnnexDropProof", "AnnexDrop_design4",
                              f"uncovered-{constant}", reject=True)

        for constant, old, new in [("Nonce", "TRUE", "FALSE"),
                                    ("IdempotentAck", "FALSE", "TRUE")]:
            with tempfile.TemporaryDirectory() as temp:
                work = Path(temp)
                copy_models(work)
                cfg = work / "T_n42o4.cfg"
                text, count = re.subn(rf"\b{constant} = {old}",
                                      f"{constant} = {new}", cfg.read_text())
                if count != 1:
                    raise RuntimeError(f"{constant}: token coverage mutation site changed")
                cfg.write_text(text)
                self.coverage(work, "CustodyTokensProof", "T_n42o4",
                              f"uncovered-{constant}", reject=True)

        for constant, old, new in [("ForceAdopt", "TRUE", "FALSE"),
                                    ("DecidersAt", '"mixed"', '"proposal"')]:
            with tempfile.TemporaryDirectory() as temp:
                work = Path(temp)
                copy_models(work)
                cfg = work / "Authority_mixed.cfg"
                text, count = re.subn(rf"\b{constant} = {old}",
                                      f"{constant} = {new}", cfg.read_text())
                if count != 1:
                    raise RuntimeError(f"{constant}: authority coverage mutation site changed")
                cfg.write_text(text)
                self.coverage(work, "AuthorityDecidersProof", "Authority_mixed",
                              f"uncovered-{constant}", reject=True)

        with tempfile.TemporaryDirectory() as temp:
            work = Path(temp)
            copy_models(work)
            path = work / "Authority.tla"
            path.write_text(path.read_text().replace(
                "=============================================================================",
                "NoNewCommits == Len(cm) = 1\n============================================================================="))
            cfg = work / "Authority_mixed.cfg"
            cfg.write_text(cfg.read_text() + "\nINVARIANT NoNewCommits\n")
            bridge = self.configuration_theorem(work, "AuthorityDecidersProof", "Authority_mixed")
            self.proof(work, "AuthorityDecidersProof", "authority-extra-unproved-claim",
                       reject=True, bridge=bridge)

        for name, changes in [
            ("purge-seals-only", [("Mode", '"full"', '"seals"')]),
            ("purge-no-seals", [("Mode", '"full"', '"none"')]),
            ("purge-no-custodians", [("Custodians", "{c1, c2, c3}", "{}"),
                                    ("Share", "{c1, c2}", "{}")]),
            ("purge-no-copies", [("Share", "{c1, c2}", "{}"),
                                ("LaptopCopies", "{l1}", "{}")]),
        ]:
            with tempfile.TemporaryDirectory() as temp:
                work = Path(temp)
                copy_models(work)
                cfg = work / "Purge_full3.cfg"
                text = cfg.read_text()
                for constant, old, new in changes:
                    text, count = re.subn(rf"\b{constant} = {re.escape(old)}",
                                          f"{constant} = {new}", text)
                    if count != 1:
                        raise RuntimeError(f"{name}: coverage mutation site changed")
                cfg.write_text(text)
                self.coverage(work, "PurgeProof", "Purge_full3", name, reject=True)

    def purge_tlc(self, work, name, reject=False, large=False):
        config = "Purge_full3" if large else "Purge_full"
        cmd = [self.java, "-Xmx1g", "-Xss16m", "-XX:+UseParallelGC", f"-Djava.io.tmpdir={work}",
               "-cp", str(self.jar), "tlc2.TLC", "-workers", "1",
               "-metadir", str(work / name), "-config", config + ".cfg", "Purge"]
        code, output = self.run(name, cmd, work, timeout=1800 if large else 120)
        if reject:
            if code != 12 or not re.search(
                    r"Error: Invariant (KeepWins|WaitingPeriod|NoResurrection) is violated", output):
                raise RuntimeError(f"{name}: expected a purge safety counterexample")
        elif code or "Model checking completed. No error has been found." not in output:
            raise RuntimeError(f"{name}: independent finite purge check failed")

    def benchmark_purge(self):
        with tempfile.TemporaryDirectory() as temp:
            work = Path(temp)
            copy_models(work)
            self.purge_tlc(work, "tlc-Purge_full3", large=True)

    def tokens_tlc(self, work, name, reject=False, large=False):
        config = "T_n42o4" if large else "TokenMutation"
        if not large:
            # Four offers are needed for the replayed-ack counterexample;
            # keep the positive proof's flags while changing the action.
            cfg = (work / "T_idem.cfg").read_text().replace("IdempotentAck = TRUE",
                                                         "IdempotentAck = FALSE")
            (work / "TokenMutation.cfg").write_text(cfg)
        cmd = [self.java, "-Xmx1g", "-Xss16m", "-XX:+UseParallelGC", f"-Djava.io.tmpdir={work}",
               "-cp", str(self.jar), "tlc2.TLC", "-workers", "1",
               "-metadir", str(work / name), "-config", config + ".cfg", "CustodyTokens"]
        code, output = self.run(name, cmd, work, timeout=1800 if large else 120)
        if reject:
            if code != 12 or "Error: Invariant TokensNeverLost is violated" not in output:
                raise RuntimeError(f"{name}: expected a token safety counterexample")
        elif code or "Model checking completed. No error has been found." not in output:
            raise RuntimeError(f"{name}: independent finite token check failed")

    def benchmark_tokens(self):
        with tempfile.TemporaryDirectory() as temp:
            work = Path(temp)
            copy_models(work)
            self.tokens_tlc(work, "tlc-T_n42o4", large=True)

    def authority_tlc(self, work, name, reject=False):
        cmd = [self.java, "-Xmx1g", "-Xss16m", "-XX:+UseParallelGC", f"-Djava.io.tmpdir={work}",
               "-cp", str(self.jar), "tlc2.TLC", "-workers", "1",
               "-metadir", str(work / name), "-config", "Authority_decide.cfg", "Authority"]
        code, output = self.run(name, cmd, work)
        if reject:
            if code != 12 or "Error: Invariant DecidersCanAdopt is violated" not in output:
                raise RuntimeError(f"{name}: expected an adoption-permission counterexample")
        elif code or "Model checking completed. No error has been found." not in output:
            raise RuntimeError(f"{name}: independent finite authority check failed")

    def authority_equivalence(self):
        cmd = [sys.executable, str(ROOT / "scripts/check-authority-folds"),
               "--out", str(self.out / "authority-folds")]
        code, output = self.run("authority-fold-equivalence", cmd, ROOT)
        if (code or "equivalence: pass" not in output
                or "mutant: violation:HistoryViewsAgree" not in output):
            raise RuntimeError("Authority fold comparison or its mutant failed")

    def benchmark(self, apalache, include_slow):
        with tempfile.TemporaryDirectory() as temp:
            work = Path(temp)
            copy_models(work)
            for config, module in [("CaptureTransaction_safe", "CaptureTransaction"),
                                    ("AnnexDrop_design4", "AnnexDrop")]:
                if module == "AnnexDrop" and not include_slow:
                    continue
                cmd = [self.java, "-Xmx1g", "-Xss16m", "-XX:+UseParallelGC", f"-Djava.io.tmpdir={work}",
                       "-cp", str(self.jar), "tlc2.TLC", "-workers", "1",
                       "-metadir", str(work / config), "-config", config + ".cfg", module]
                code, output = self.run("tlc-" + config, cmd, work, timeout=1800)
                if code or "Model checking completed. No error has been found." not in output:
                    raise RuntimeError(f"{config}: TLC benchmark failed")
            base = ["env", "JVM_ARGS=-Xmx1g", str(apalache), "check", "--cinit=ConstInit",
                    "--config-file=" + str(work / "apalache.json")]
            (work / "apalache.json").write_text('{}\n')
            cases = [("bounded-10", "Init", "CapturedBeforeDisplacement", "10"),
                     ("induction-base", "Init", "Inductive", "0"),
                     ("induction-step", "Inductive", "Inductive", "1"),
                     ("induction-property", "Inductive", "CapturedBeforeDisplacement", "0")]
            for name, init, inv, length in cases:
                cmd = base + ["--init=" + init, "--inv=" + inv, "--length=" + length,
                              "--out-dir=" + str(self.out / name), "CaptureTransactionSymbolic.tla"]
                code, output = self.run("apalache-" + name, cmd, work)
                if code or "EXITCODE: OK" not in output:
                    raise RuntimeError(f"{name}: Apalache benchmark failed")
            path = work / "CaptureTransactionSymbolic.tla"
            path.write_text(path.read_text().replace("Off = {}", 'Off = {"guard"}'))
            cmd = base + ["--inv=CapturedBeforeDisplacement", "--length=6",
                          "--out-dir=" + str(self.out / "unguarded"), "CaptureTransactionSymbolic.tla"]
            code, output = self.run("apalache-unguarded", cmd, work)
            if (code != 12 or "The outcome is: Error" not in output
                    or not re.search(r"state invariant \d+ violated", output)):
                raise RuntimeError("Apalache did not find the unguarded-install counterexample")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--out", type=Path, default=ROOT / "target/formal-proofs")
    parser.add_argument("--tlapm")
    parser.add_argument("--java", default=os.environ.get("JAVA", "java"))
    parser.add_argument("--no-mutants", action="store_true", help="local proof-only timing")
    parser.add_argument("--benchmark", action="store_true", help="also compare TLC and Apalache")
    parser.add_argument("--include-slow", action="store_true", help="benchmark the large TLC drop graph")
    parser.add_argument("--benchmark-purge", action="store_true", help="also time the large finite purge graph")
    parser.add_argument("--benchmark-tokens", action="store_true", help="also time the large finite token graph")
    parser.add_argument("--apalache")
    args = parser.parse_args()
    args.out = args.out.resolve()
    args.out.mkdir(parents=True, exist_ok=True)
    checks = None
    try:
        tlapm = tlapm_binary(args.tlapm, args.out)
        version(tlapm, "--version", TLAPS_VERSION)
        checks = Checks(args.out, tlapm, args.java)
        checks.positives()
        if not args.no_mutants:
            checks.mutants()
            checks.authority_equivalence()
        if args.benchmark_purge:
            checks.benchmark_purge()
        if args.benchmark_tokens:
            checks.benchmark_tokens()
        if args.benchmark:
            apalache = apalache_binary(args.apalache)
            version(apalache, "version", APALACHE_VERSION)
            checks.benchmark(apalache, args.include_slow)
        return 0
    except (RuntimeError, subprocess.SubprocessError, OSError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1
    finally:
        if checks:
            (args.out / "timings.json").write_text(json.dumps(
                {"platform": platform.platform(), "tlaps": TLAPS_VERSION,
                 "apalache": APALACHE_VERSION, "results": checks.results}, indent=2) + "\n")


if __name__ == "__main__":
    sys.exit(main())
