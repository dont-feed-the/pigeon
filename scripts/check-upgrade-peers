#!/usr/bin/env python3
"""Exercise both roles through a mixed-release upgrade using frozen lab programs.

Independently prove current pointers, working modes and all retained bytes.
Keep original repositories and public identities. This finite fixture never
qualifies resource budgets, elapsed gates or original release archives.
"""
import argparse
import hashlib
import json
from pathlib import Path
import re
import runpy
import shutil
import signal
import tomllib

SOURCE = Path(__file__).resolve().parent
UPGRADE = runpy.run_path(str(SOURCE / 'check-upgrade'))
REFERENCE = UPGRADE['REFERENCE']


def require(condition, message):
    """Keep safety checks active under Python optimization too."""
    if not condition:
        raise RuntimeError(message)


def identity_snapshot(roster, uuids):
    """Record public identity bindings, without the invitation or other fields."""
    require(roster.get('format') == 2, 'only supported format 2 is measured')
    result = {}
    for name, role in [('laptop', 'laptop'), ('backup', 'custodian')]:
        matches = [(key, value) for key, value in roster.get('devices', {}).items()
                   if value.get('name') == 'upgrade-' + name]
        require(len(matches) == 1, 'device name is missing or ambiguous')
        device, entry = matches[0]
        require(entry.get('role') == role, 'device role differs')
        require(bool(uuids.get(name)) and entry.get('annex_uuid') == uuids[name],
                'annex identity differs from the roster')
        result[name] = dict(device=device, annex_uuid=uuids[name],
                            person=entry['person'], role=role)
    require(result['laptop']['device'] != result['backup']['device']
            and result['laptop']['annex_uuid'] != result['backup']['annex_uuid'],
            'peers must have distinct identities')
    return result


def exercise(args, report):
    report.update(old_build=UPGRADE['frozen'](args.old_bin),
                  new_build=UPGRADE['frozen'](args.new_bin),
                  harness_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
                  upgrade_observer_sha256=hashlib.sha256((SOURCE / 'check-upgrade').read_bytes()).hexdigest(),
                  reference_observer_sha256=hashlib.sha256((SOURCE / 'reference-budget').read_bytes()).hexdigest(),
                  elapsed_gate='not-measured', first_upgraded=args.first,
                  qualification='finite lab two-peer upgrade; no elapsed/resource verdict',
                  stage='starting', stages=[])
    root = args.root.resolve()
    require(not root.exists(), 'fixture root must be new')
    root.mkdir(mode=0o700, parents=True)
    folder = root / 'files'
    folder.mkdir()
    repos = dict(laptop=folder / '.git', backup=root / 'backup.git')
    peers = {name: REFERENCE['Peer'](root, args.old_bin, name, False) for name in repos}
    live = []
    current = {path: UPGRADE['fingerprint'](data) for path, data in UPGRADE['INITIAL'].items()}
    history = set(current.values())
    modes = dict(UPGRADE['MODES'])

    def checkpoint(stage):
        report['stage'] = stage
        REFERENCE['checkpoint'](args.report, report)
        print(stage, flush=True)

    def prove_both():
        for name, peer in peers.items():
            UPGRADE['wait_proved'](peer, repos[name], current, history, modes)
        require(UPGRADE['working_bytes'](folder, current, modes), 'working bytes or modes changed')

    def identities():
        roster = tomllib.loads(REFERENCE['git'](
            repos['laptop'], 'show', 'main:.pigeon/roster.toml').decode())
        uuids = {name: REFERENCE['git'](repo, 'config', 'annex.uuid').decode().strip()
                 for name, repo in repos.items()}
        return identity_snapshot(roster, uuids)

    def save(data):
        UPGRADE['atomic_save'](folder, data)
        current['notes.txt'] = UPGRADE['fingerprint'](data)
        history.add(current['notes.txt'])
        prove_both()

    def upgrade(name):
        peer = peers[name]
        original_head = UPGRADE['head'](repos[name])
        peer.stop()
        live.remove(peer)
        shutil.copy2(peer.home / 'daemon.out', root / (name + '-before-upgrade.out'))
        shutil.copytree(repos[name], root / (name + '-original.git'), symlinks=True,
                        ignore=UPGRADE['exclude_sockets'])
        peer.binary = args.new_bin
        live.append(peer)
        peer.start()
        prove_both()
        require(UPGRADE['head'](repos[name]) == original_head,
                'upgrade changed accepted head without a save')
        require(identities() == before_identity, 'upgrade changed device or annex identity')
        report['stages'].append(dict(upgraded=name, original_head=original_head,
                                     retained_objects=len(history), identities_preserved=True))

    failed = True
    try:
        for peer in peers.values():
            live.append(peer)
            peer.start()
        for path, data in UPGRADE['INITIAL'].items():
            file = folder / path
            file.parent.mkdir(exist_ok=True)
            file.write_bytes(data)
            file.chmod(modes[path])
        checkpoint('creating historical group and backup')
        peers['laptop'].cli('create', 'Upgrade peers', str(folder), '--k', '1',
                            '--name', 'upgrade-laptop')
        answer = peers['laptop'].cli('invite')
        command = next(row['message']['args']['command'] for row in answer
                       if row['type'] == 'Said' and row['message']['id'] == 'invitation')
        code = re.search(r'pgn2-[A-Za-z0-9_-]+', command)[0]
        people = next(row['people'] for row in peers['laptop'].cli('people')
                      if row['type'] == 'People')
        person = next(row['name'] for row in people if row['this_person'])
        peers['backup'].cli('join', '--backup-machine', code, str(repos['backup']),
                           '--name', 'upgrade-backup', '--person', person, '--yes')
        prove_both()
        save(b'second historical peer notes\n')
        before_identity = identities()
        report['initial_identities'] = before_identity
        checkpoint('upgrading first peer while other remains old')
        upgrade(args.first)
        checkpoint('capturing with mixed-release peers')
        save(b'a new save across mixed-release peers\n')
        report['mixed_release_save'] = True
        checkpoint('upgrading remaining peer')
        upgrade('backup' if args.first == 'laptop' else 'laptop')
        checkpoint('restoring oldest historical bytes after both upgrades')
        peers['laptop'].cli('restore', str(folder / 'notes.txt'), '--version', '1', '--yes')
        current['notes.txt'] = UPGRADE['fingerprint'](UPGRADE['INITIAL']['notes.txt'])
        prove_both()
        report.update(stage='completed', verdict='two-peer-upgrade-passed',
                      independently_verified_retained_objects=len(history))
        failed = False
    finally:
        REFERENCE['stop_peers'](live, report, failed)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['old-bin', 'new-bin', 'root', 'report']:
        parser.add_argument('--' + name, type=Path, required=True)
    parser.add_argument('--first', choices=['laptop', 'backup'], required=True)
    args = parser.parse_args()
    if args.report.exists():
        parser.error('report must be new; previous evidence is never overwritten')
    args.old_bin = args.old_bin.resolve()
    args.new_bin = args.new_bin.resolve()
    report = dict(schema=1)
    try:
        exercise(args, report)
    except BaseException as error:
        report.update(stage='failed', verdict='failed', error=type(error).__name__)
        raise SystemExit(1) from None
    finally:
        REFERENCE['checkpoint'](args.report, report)


if __name__ == '__main__':
    def interrupted(_signal, _frame):
        raise KeyboardInterrupt('upgrade observation interrupted')
    signal.signal(signal.SIGTERM, interrupted)
    main()
