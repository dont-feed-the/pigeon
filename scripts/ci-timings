#!/usr/bin/env python3
"""Where CI time goes: each job's wait for a runner and run, its steps of a
minute or more, and, with --artifacts, the slice's time per scenario
(summary.md) and per S9 schedule (timings.txt).

Usage: scripts/ci-timings [RUN_ID ...] [--branch main] [--artifacts]
Without RUN_ID, the last completed run of ci, lab, slice and models-full on
the branch. It asks the GitHub API through `gh api`, or with curl and
$GITHUB_TOKEN when gh is missing.
"""

import datetime
import io
import json
import os
import shutil
import subprocess
import sys
import zipfile

REPO = "mariogeiger/pigeon"
WORKFLOWS = ("ci", "lab", "slice", "models-full")


def api(path, raw=False):
    if shutil.which("gh"):
        out = subprocess.run(["gh", "api", path], check=True, capture_output=True).stdout
    else:
        url = path if path.startswith("http") else f"https://api.github.com{path}"
        auth = ["-H", f"Authorization: Bearer {os.environ['GITHUB_TOKEN']}"]
        out = subprocess.run(["curl", "-sfL", *auth, url], check=True, capture_output=True).stdout
    return out if raw else json.loads(out)


def when(text):
    return datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))


def minutes(a, b):
    return (when(b) - when(a)).total_seconds() / 60


def jobs(run):
    print(f"\n## {run['name']} {run['head_sha'][:7]} ({run['conclusion']}) run {run['id']}")
    for j in api(f"/repos/{REPO}/actions/runs/{run['id']}/jobs?per_page=100")["jobs"]:
        if not j.get("completed_at") or not j.get("started_at"):
            continue
        wait = minutes(j["created_at"], j["started_at"])
        took = minutes(j["started_at"], j["completed_at"])
        print(f"{j['name'][:55]:55} wait {wait:5.1f} min  run {took:5.1f} min")
        for s in j["steps"]:
            if s.get("started_at") and s.get("completed_at"):
                m = minutes(s["started_at"], s["completed_at"])
                if m >= 1:
                    print(f"    {s['name'][:60]:60} {m:5.1f} min")


def artifacts(run):
    for a in api(f"/repos/{REPO}/actions/runs/{run['id']}/artifacts")["artifacts"]:
        if not a["name"].startswith(("slice-", "s9-random-")):
            continue
        z = zipfile.ZipFile(io.BytesIO(api(a["archive_download_url"], raw=True)))
        for name in ("summary.md", "timings.txt"):
            if name in z.namelist():
                print(f"\n### {a['name']}/{name}")
                print(z.read(name).decode())


def main(args):
    branch = "main"
    if "--branch" in args:
        branch = args[args.index("--branch") + 1]
    ids = [a for a in args if a.isdigit()]
    if ids:
        runs = [api(f"/repos/{REPO}/actions/runs/{i}") for i in ids]
    else:
        listed = api(f"/repos/{REPO}/actions/runs?per_page=50&status=completed&branch={branch}")
        runs, seen = [], set()
        for r in listed["workflow_runs"]:
            if r["name"] in WORKFLOWS and r["name"] not in seen and r["conclusion"] != "cancelled":
                seen.add(r["name"])
                runs.append(r)
    for r in runs:
        jobs(r)
        if "--artifacts" in args:
            artifacts(r)


if __name__ == "__main__":
    main(sys.argv[1:])
