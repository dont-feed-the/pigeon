#!/usr/bin/env python3
"""Check observed daemon transitions with the actual CaptureInstall actions.

Each device/group/path is a single-file projection. Inodes and content
hashes receive stable integer names; equality and membership are preserved.
The encoder never computes the result of an operation. TLC must explain
both snapshots with that operation of CaptureInstall, including its guards.
Missing snapshots, unknown actions, observation errors and empty coverage
fail. Environment inference between operations is explicitly bounded.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import re
import shutil
import sys
import tempfile
from collections import defaultdict
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
FIELDS = {"p", "aside", "stage", "kept", "index", "current", "clean", "signed",
          "physical_index", "open", "proved", "new", "expected", "expected_stat", "divergence", "mine", "pending", "allowed", "hidden", "operation", "recent"}
ACTIONS = {"Capture", "Start", "TakeGroup", "MoveAside", "Scan", "Check", "RenameIn",
           "Index", "Done", "Release", "Recover", "RecoverEnd", "Cleanup", "Conflict", "Resolve", "Withdraw", "Decide", "Reconcile", "Adopt"}


FILESYSTEM_SPECS = {"CaptureInstall", "Evict", "Thin", "Restore", "Resolve"}


class Refused(Exception):
    pass


def load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "scripts" / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def files(state):
    return [state[n] for n in ("p", "aside", "stage")] + state["kept"]


def validate(state):
    if missing := FIELDS - state.keys():
        raise Refused(f"missing observed fields: {sorted(missing)}")
    for key in ("clean", "open", "proved", "pending", "allowed", "hidden", "recent"):
        if type(state[key]) is not bool:
            raise Refused(f"{key} must be an observed boolean")
    for key in ("index", "physical_index", "current", "new", "expected", "mine", "expected_stat", "operation"):
        if not isinstance(state[key], str):
            raise Refused(f"{key} must be a content hash")
    if not state["pending"] and state["index"] != state["physical_index"]:
        raise Refused("logical and physical index disagree without a pending capture")
    if state["divergence"] not in {"none", "waiting", "conflict"}:
        raise Refused("invalid divergence state")
    if not isinstance(state["signed"], list) or not all(isinstance(k, str) for k in state["signed"]):
        raise Refused("signed content must be a list of hashes")
    if not isinstance(state["kept"], list):
        raise Refused("kept inodes must be a list")
    for f in files(state):
        if not all(isinstance(f[n], str) for n in ("inode", "content", "stat")) or type(f["writers"]) is not bool:
            raise Refused("invalid file observation")
        if bool(f["inode"]) != bool(f["content"]) or (not f["inode"] and f["writers"]):
            raise Refused("absent inode has content or writers")
    if not all(isinstance(f["expected"], str) for f in state["kept"]):
        raise Refused("kept inode has no expected hash")


def pairs(events):
    """Pair only actual matching edges; no missing action is synthesized."""
    out, pending = [], None
    for event in events:
        v = event["vars"]
        if "state" in v:
            validate(v["state"])
        if event["action"] not in ACTIONS:
            raise Refused(f"unknown action {event['action']}")
        if "error" in v:
            raise Refused(f"observation failed at clock {event['clock']}: {v['error']}")
        if v["edge"] == "before":
            if pending:
                p = pending["vars"]
                if p["run"] == v["run"]:
                    raise Refused("missing after observation")
                # A restarted process supplies the next real checkpoint.
                # TLC must still explain the unfinished operation or its
                # absence; no output or missing driver action is invented.
                out.append(dict(pending, vars={"before": p["state"], "after": v["state"],
                    "phase": "", "ok": False, "crashed": True, "kind": p["kind"], "request": p["request"]}))
            pending = event
            continue
        if not pending or v["edge"] != "after":
            raise Refused(f"unpaired {v['edge']} observation")
        p = pending["vars"]
        if (pending["action"], p["seq"], p["kind"], p["run"]) != (event["action"], v["seq"], v["kind"], v["run"]):
            raise Refused("operation identity changed between observations")
        if type(v["ok"]) is not bool:
            raise Refused("missing operation outcome")
        out.append(dict(event, vars={"before": p["state"], "after": v["state"], "phase": v["phase"], "ok": v["ok"], "crashed": False, "kind": p["kind"], "request": p["request"]}))
        pending = None
    if pending:
        raise Refused("truncated operation: no after observation")
    return out


def normalize(events):
    """Rename real identities, retaining every independently observed fact."""
    relevant = set()
    inode, content = {"": 0}, {"": 0}

    def number(table, value):
        if value not in table:
            table[value] = len(table)
        return table[value]

    def state(s):
        relevant.update(s[n] for n in ("index", "current", "new", "expected", "mine"))
        relevant.update(f["content"] for f in files(s))
        relevant.update(f["expected"] for f in s["kept"])
        relevant.discard("")
        c = lambda value: number(content, value)
        i = lambda value: number(inode, value)
        result = {n: c(s[n]) for n in ("index", "current", "new", "expected", "mine")}
        by_inode = {}
        for f in files(s):
            if not f["inode"]:
                continue
            value = {"i": i(f["inode"]), "c": c(f["content"]), "w": f["writers"]}
            if value["i"] in by_inode and by_inode[value["i"]] != value:
                raise Refused("inconsistent observations of the same inode")
            by_inode[value["i"]] = value
        result.update({n: i(s[n]["inode"]) for n in ("p", "aside", "stage")})
        result["kept"] = [{"i": i(f["inode"]), "e": c(f["expected"])} for f in s["kept"]]
        result["files"] = list(by_inode.values())
        result["signed"] = sorted(c(k) for k in s["signed"] if k in relevant)
        result["proof_matches"] = s["aside"]["stat"] == s["expected_stat"]
        result["path_matches"] = s["p"]["stat"] == s["expected_stat"]
        result["expected_inode"] = i(":".join(s["expected_stat"].split(":")[:2])) if s["expected_stat"] else 0
        result.update({n: s[n] for n in ("clean", "open", "proved", "divergence", "pending", "hidden", "operation", "recent", "allowed")})
        return result

    def request(key):
        if not key:
            return 0
        match = re.fullmatch(r"SHA256E?-s[0-9]+--([a-f0-9]{64})(?:\..*)?", key)
        if not match:
            raise Refused("unsupported requested content key")
        relevant.add(match[1])
        return number(content, match[1])

    out = []
    for e in events:
        wanted = request(e["vars"]["request"])
        out.append(dict(e, vars={"before": state(e["vars"]["before"]), "after": state(e["vars"]["after"]),
                         "phase": e["vars"]["phase"], "ok": e["vars"]["ok"], "crashed": e["vars"]["crashed"],
                         "kind": e["vars"]["kind"], "request": wanted}))
    return out, len(inode) - 1, len(content) - 1


def check(events, java, budget, diagnostics=True):
    identity, clock = None, -1
    for e in events:
        here = (e["device"], e["vars"]["group"], e["vars"]["path"])
        if identity is not None and identity != here:
            raise Refused("mixed path/device identities")
        if e["clock"] <= clock:
            raise Refused("trace clock did not increase")
        identity, clock = here, e["clock"]
    paired = pairs(events)
    events, inodes, contents = normalize(paired)
    if not events:
        raise Refused("no implementation transitions")
    tla, tlc = load("trace-to-tla"), load("run-tlc")
    with tempfile.TemporaryDirectory(prefix="pigeon-install-tlc-") as tmp:
        work = Path(tmp)
        for name in ("CaptureInstall", "DaemonDriver", "CaptureInstallTrace"):
            shutil.copy(ROOT / "models/tla" / (name + ".tla"), work)
        (work / "CaptureInstallCodeLog.tla").write_text(tla.convert(
            [json.dumps(e) for e in events], "CaptureInstallCodeLog", "CodeLog"))
        bound = max(contents, len(events) * budget + 1)
        config = f"""CONSTANTS TraceLog <- CodeLog
EnvBudget = {budget}
MaxAct = {bound}
MaxGroup = {bound}
MaxCrash = {len(events)}
MaxRes = {bound}
MaxIno = {inodes + budget + 1}
Allowed = TRUE
Hidden = TRUE
Off = {{}}
SPECIFICATION TraceSpec
INVARIANT TraceNotConsumed
CHECK_DEADLOCK FALSE
"""
        (work / "CaptureInstallTrace_good.cfg").write_text(config)
        got, output = tlc.run(tlc.tlc_jar(), "CaptureInstallTrace_good", "CaptureInstallTrace", java, "1", "2g", models=work)
        if got != "trace:accepted" and diagnostics:
            print(tlc.excerpt(output), file=sys.stderr)
        return got


def streams(root):
    """Return complete streams, preserving per-device observation order."""
    for log in sorted(root.rglob("*.ndjson")):
        groups, previous = defaultdict(list), {}
        for line in log.read_text().splitlines():
            if not line.strip():
                continue
            e = json.loads(line)
            if e["spec"] not in FILESYSTEM_SPECS:
                continue
            if e["clock"] <= previous.get(e["device"], -1):
                raise Refused(f"{log}: trace clock did not increase")
            previous[e["device"]] = e["clock"]
            v = e["vars"]
            groups[e["device"], v["group"], v["path"]].append(e)
        for identity, events in groups.items():
            yield log, identity, events


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("out", type=Path)
    parser.add_argument("--java", default="java")
    parser.add_argument("--environment-steps", type=int, default=4)
    args = parser.parse_args()
    failures, checked = 0, 0
    try:
        for log, identity, events in streams(args.out):
            try:
                got = check(events, args.java, args.environment_steps)
                ok = got == "trace:accepted"
                print(f"{'ok' if ok else 'FAIL'} {log.parent.name} {identity[-1]}: {got}", flush=True)
                checked += ok
                failures += not ok
            except (Refused, KeyError, TypeError, ValueError) as error:
                print(f"FAIL {log}: {error}", flush=True)
                failures += 1
    except (Refused, KeyError, TypeError, ValueError) as error:
        print(f"FAIL {error}", flush=True)
        failures += 1
    if not checked:
        print("FAIL no CaptureInstall implementation trace was checked", flush=True)
        failures += 1
    return bool(failures)


if __name__ == "__main__":
    sys.exit(main())
