#!/usr/bin/env python3
"""Check real bridge catalogue RPC observations with TLC, including mutants.

With no path, run socket-level Rust tests with tracing enabled, require their
coverage, replay every stream and corrupt real outputs. With a path, replay
its catalogue-*.ndjson logs. Missing, unknown and incomplete logs fail closed.
"""
import argparse
import copy
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent


def load(name):
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / 'scripts' / name))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


tlc, encoder = load('run-tlc'), load('trace-to-tla')


class Refused(Exception):
    pass


def fields(value, names):
    if not isinstance(value, dict) or set(value) != set(names.split()):
        raise Refused(f'fields differ from {names}')


def normalize(events):
    """Rename revisions/etags by equality, paths by Rust UTF-8 byte order.

    No cursor, metadata or control step is supplied or repaired here. Raw
    replies that Rust rejects remain in the trace for the model to consume.
    """
    if not events or events[0]['action'] != 'Begin':
        raise Refused('missing Begin')
    paths, tokens = set(), {'': -1}
    def gather(v):
        if isinstance(v, dict):
            if 'path' in v:
                if not isinstance(v['path'], str):
                    raise Refused('path is not a string')
                paths.add(v['path'])
            if isinstance(v.get('after'), str):
                paths.add(v['after'])
            for x in v.values():
                gather(x)
        elif isinstance(v, list):
            for x in v:
                gather(x)
    gather(events)
    path_ids = {p: i+1 for i, p in enumerate(sorted(paths, key=lambda p: p.encode('utf-8')))}
    def token(v):
        if v is None:
            return 0
        if not isinstance(v, str):
            raise Refused('identity is not a string')
        return tokens.setdefault(v, len(tokens))
    def cursor(v):
        if v is None:
            return dict(present=False, revision=0, after=0)
        fields(v, 'revision after')
        return dict(present=True, revision=token(v['revision']), after=0 if v['after'] is None else path_ids[v['after']])
    def files(v):
        if not isinstance(v, list):
            raise Refused('files is not a sequence')
        result = []
        for f in v:
            fields(f, 'path etag size diverging')
            if type(f['size']) is not int or f['size'] < 0 or type(f['diverging']) is not bool:
                raise Refused('invalid file metadata')
            result.append(dict(path=path_ids[f['path']], etag=token(f['etag']),
                               size=f['size'], diverging=f['diverging']))
        return result
    out, required = [], 0
    for clock, e in enumerate(events, 1):
        fields(e, 'spec clock action vars')
        if e['spec'] != 'BridgeCatalogue' or type(e['clock']) is not int or e['clock'] != clock:
            raise Refused('unknown family or missing/reordered event')
        a, v = e['action'], e['vars']
        item = dict(action=a)
        if a == 'Begin' and clock == 1:
            fields(v, 'required')
            required = token(v['required'])
            continue
        if a == 'Request':
            fields(v, 'cursor'); item['cursor'] = cursor(v['cursor'])
        elif a == 'Reply':
            fields(v, 'reply'); r = v['reply']
            if r.get('kind') == 'snapshot':
                fields(r, 'kind revision files next')
                item.update(status=0, page=dict(revision=token(r['revision']), files=files(r['files']), next=cursor(r['next'])))
            elif r.get('kind') == 'failure':
                if set(r) not in ({'kind', 'status'}, {'kind', 'status', 'message'}):
                    raise Refused('invalid failure')
                if type(r['status']) is not int or not 400 <= r['status'] <= 599:
                    raise Refused('invalid failure status')
                item['status'] = r['status']
            else:
                raise Refused('unsupported RPC reply')
        elif a == 'Continue':
            fields(v, 'cursor files'); item.update(cursor=cursor(v['cursor']), files=files(v['files']))
        elif a == 'Publish':
            fields(v, 'revision files'); item.update(revision=token(v['revision']), files=files(v['files']))
        elif a == 'Retry':
            fields(v, '')
        elif a == 'Abort':
            fields(v, 'status'); item['status'] = v['status']
        else:
            raise Refused('unknown action')
        out.append(item)
    if not out or out[-1]['action'] not in {'Publish', 'Abort'}:
        raise Refused('truncated read')
    return out, required


def check(events, java='java', diagnostics=True):
    events, required = normalize(events)
    with tempfile.TemporaryDirectory(prefix='bridge-catalogue-tlc-') as tmp:
        work = Path(tmp)
        for name in ('BridgeCatalogue', 'BridgeCatalogueTrace'):
            shutil.copy(ROOT / 'models/tla' / (name + '.tla'), work)
        (work / 'BridgeCatalogueCodeLog.tla').write_text(
            '---- MODULE BridgeCatalogueCodeLog ----\nEXTENDS Naturals\nCodeLog == '
            + encoder.encode(events) + '\n====\n')
        (work / 'Observed.cfg').write_text(f'''CONSTANTS Required = {required} WeakRevision = FALSE
TraceLog <- CodeLog
SPECIFICATION TraceSpec
INVARIANT TraceNotConsumed
CHECK_DEADLOCK FALSE
''')
        verdict, output = tlc.run(tlc.tlc_jar(), 'Observed', 'BridgeCatalogueTrace', java, '1', '1g', models=work)
        if verdict != 'trace:accepted' and diagnostics:
            print(tlc.excerpt(output), file=sys.stderr)
        return verdict


def mutations(streams, java):
    success = next(e for e in streams if e[-1]['action'] == 'Publish' and len(e[-1]['vars']['files']) == 2)
    mutants = {}
    m = copy.deepcopy(success); m[-1]['vars']['files'].pop(); mutants['partial publication'] = m
    m = copy.deepcopy(success); m[-1]['vars']['files'][0]['etag'] += '-wrong'; mutants['wrong checksum metadata'] = m
    m = copy.deepcopy(success); m[-1]['vars']['revision'] += '-wrong'; mutants['wrong published revision'] = m
    m = copy.deepcopy(success)
    j = next(i for i, e in enumerate(m) if e['action'] == 'Continue')
    m[j]['vars']['cursor']['after'] = m[-1]['vars']['files'][-1]['path']; mutants['skipped continuation'] = m
    m = copy.deepcopy(success); m[j]['vars']['files'] = []; mutants['dropped first page'] = m
    m = copy.deepcopy(success)
    j = [i for i, e in enumerate(m) if e['action'] == 'Reply'][-1]
    m[j]['vars']['reply']['revision'] += '-wrong'; mutants['mixed page revisions'] = m
    retried = next(e for e in streams if any(x['action'] == 'Retry' for x in e) and e[-1]['action'] == 'Publish')
    m = copy.deepcopy(retried); m[-1]['vars']['files'].append(m[-1]['vars']['files'][0]); mutants['stale retry buffer'] = m
    pinned = next(e for e in streams if e[0]['vars']['required'] is not None and e[-1]['action'] == 'Publish')
    m = copy.deepcopy(pinned); m[1]['vars']['cursor'] = None; mutants['unpinned post-save read'] = m
    for name, events in mutants.items():
        verdict = check(events, java, False)
        if not verdict.startswith('trace:rejected:'):
            raise Refused(f'{name}: expected TLC rejection, got {verdict}')
        print(f'ok   rejects {name}', flush=True)
    for name, events in [('truncated stream', success[:-1]), ('empty stream', [])]:
        try:
            normalize(events)
        except Refused:
            print(f'ok   refuses {name}', flush=True)
        else:
            raise Refused(f'accepted {name}')


def replay(root, java, regression=False):
    streams = []
    for path in sorted(root.rglob('catalogue-*.ndjson')):
        events = [json.loads(line, object_pairs_hook=encoder.pairs) for line in path.read_text().splitlines()]
        verdict = check(events, java)
        if verdict != 'trace:accepted':
            raise Refused(f'{path.name}: {verdict}')
        streams.append(events)
    if not streams:
        raise Refused('no catalogue traces')
    print(f'ok   TLC accepts {len(streams)} real catalogue reads', flush=True)
    if regression:
        if len(streams) != 11:
            raise Refused(f'expected 11 independent reads, got {len(streams)}')
        actions = {e['action'] for s in streams for e in s}
        if actions != {'Begin', 'Request', 'Reply', 'Continue', 'Publish', 'Abort', 'Retry'}:
            raise Refused('missing action coverage')
        if not any(len(e['vars']['files']) == 4000 for s in streams for e in s if e['action'] == 'Publish'):
            raise Refused('missing large catalogue')
        mutations(streams, java)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('path', nargs='?', type=Path)
    parser.add_argument('--java', default=os.environ.get('JAVA', 'java'))
    args = parser.parse_args()
    if args.path:
        replay(args.path, args.java)
    else:
        with tempfile.TemporaryDirectory(prefix='bridge-catalogue-regression-') as tmp:
            env = dict(os.environ, PIGEON_TRACE='1', PIGEON_TRACE_DIR=tmp)
            subprocess.run(['cargo', 'test', '--locked', '-p', 'pigeon-bridge', '--features', 'tla-trace',
                            'catalogue::tests::'], cwd=ROOT, env=env, check=True)
            replay(Path(tmp), args.java, True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (Refused, encoder.Refused, KeyError, TypeError, ValueError, OSError) as error:
        sys.exit(f'FAIL {error}')
