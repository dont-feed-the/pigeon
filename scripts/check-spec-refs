#!/usr/bin/env python3
"""Fail when a file cites a section of docs/spec/ that does not exist.

A section is a heading `## N.M Title` of `docs/spec/NN-*.md`, where N is the
file's number; `NN` alone names the file. A citation is `NN §N.M` (a range
`§N.M–N.P` checks both ends), a bare `§N.M`, or a link `[..](NN-name.md)`
from the spec to a sibling file. `NN §N.M` must also agree with itself (8 is
08). Citations of other documents (`ux.md §2`, `proposal §5`) and the
history in `docs/design/` are not checked. With no arguments, every file
tracked by Git is read; otherwise the files named.
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPEC = ROOT / "docs" / "spec"
OTHER = re.compile(r"(ux(\.md)?|proposal|draft[-\w.]*|REVIEW(\.md)?|RFC \d+|section)\s*$", re.I)
CITE = re.compile(r"(?:\b(\d\d)\s+)?§\s*(\d+)(?:\.(\d+))?(?:\s*[–-]\s*(?:§\s*)?(\d+)\.(\d+))?")
LINK = re.compile(r"\]\((\d\d-[a-z0-9-]+\.md)(?:#[^)]*)?\)")


def sections():
    files, ids = {}, set()
    for f in SPEC.glob("[0-9][0-9]-*.md"):
        n = int(f.name[:2])
        files[f.name] = n
        ids.add((n, None))
        for line in f.read_text().splitlines():
            m = re.match(r"##\s+(\d+)\.(\d+)\s", line)
            if m:
                if int(m.group(1)) != n:
                    yield f"{f.relative_to(ROOT)}: heading {m.group(1)}.{m.group(2)} in file {n:02}"
                ids.add((int(m.group(1)), int(m.group(2))))
    sections.files, sections.ids = files, ids


def check(path, text, problems):
    in_spec = path.parent == SPEC
    for no, line in enumerate(text.splitlines(), 1):
        where = f"{path.relative_to(ROOT)}:{no}"
        for m in CITE.finditer(line):
            before = line[: m.start()]
            if OTHER.search(before.rstrip(" (")) or OTHER.search(before[-30:].split(",")[-1].strip()):
                continue
            nn, a, b, c, d = m.groups()
            if nn is None and b is None:
                continue  # a bare §N names some other document's part
            if nn is not None and int(nn) != int(a):
                problems.append(f"{where}: {nn} §{a}{'.' + b if b else ''} disagrees with itself")
            for x, y in ((a, b), (c, d)):
                if x is not None and (int(x), int(y) if y else None) not in sections.ids:
                    problems.append(f"{where}: no spec section {x}{'.' + y if y else ''}")
        if in_spec:
            for m in LINK.finditer(line):
                if m.group(1) not in sections.files:
                    problems.append(f"{where}: no spec file {m.group(1)}")


def main(args):
    problems = list(sections())
    if args:
        paths = [Path(a).resolve() for a in args]
    else:
        out = subprocess.run(["git", "ls-files"], cwd=ROOT, capture_output=True, text=True, check=True)
        paths = [ROOT / p for p in out.stdout.splitlines()]
    for p in paths:
        if "docs/design/" in str(p.relative_to(ROOT)) or not p.is_file():
            continue
        try:
            text = p.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        check(p, text, problems)
    for p in problems:
        print(p)
    print(f"check-spec-refs: {len(problems)} problem(s), {len(sections.ids)} sections", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
