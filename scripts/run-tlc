#!/usr/bin/env python3
"""Run the TLA+ models and compare each TLC verdict with the expected one.

The expectations live in models/tla/expected.tsv. The TLC jar is pinned by
version and SHA-256, downloaded once into a cache directory, and refused when
its hash differs. Usage: scripts/run-tlc [--full] [config ...]; with no
configuration named, the fast set runs, or every row with --full. --shard I N
runs the zero-based shard I of N, partitioning the selected rows in order.
"""

import argparse
import hashlib
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

TLC_VERSION = "1.7.4"
TLC_URL = f"https://github.com/tlaplus/tlaplus/releases/download/v{TLC_VERSION}/tla2tools.jar"
TLC_SHA256 = "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
MODELS = Path(__file__).resolve().parent.parent / "models" / "tla"


def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def tlc_jar():
    """Return the path of the pinned jar, downloading it when absent."""
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pigeon"
    jar = cache / f"tla2tools-{TLC_VERSION}.jar"
    if not jar.exists():
        cache.mkdir(parents=True, exist_ok=True)
        partial = jar.with_suffix(".part")
        urllib.request.urlretrieve(TLC_URL, partial)
        partial.rename(jar)
    if sha256(jar) != TLC_SHA256:
        sys.exit(f"{jar}: SHA-256 differs from the pinned {TLC_SHA256}; delete it and retry")
    return jar


def expectations():
    """Yield (config, module, set, verdict) rows of expected.tsv."""
    for line in (MODELS / "expected.tsv").read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            yield tuple(line.split("\t"))


def verdict(output, trace=False):
    """Name the outcome of one TLC run from its output.

    A trace configuration (invariant TraceNotConsumed, spec 13 §13.3) accepts its log
    when a behaviour violates that invariant, and otherwise names the first line
    that no behaviour explains: the depth of TLC's search.
    """
    if trace:
        if "Error: Invariant TraceNotConsumed is violated" in output:
            return "trace:accepted"
        depth = re.search(r"The depth of the complete state graph search is (\d+)", output)
        if "No error has been found." in output and depth:
            return f"trace:rejected:{depth.group(1)}"
        return "error"
    if "Model checking completed. No error has been found." in output:
        return "pass"
    if "Error: Deadlock reached." in output:
        return "deadlock"
    found = re.search(r"Error: Invariant (\w+) is violated", output)
    if found:
        return f"violation:{found.group(1)}"
    if "Temporal properties were violated" in output:
        return "violation:temporal"
    return "error"


def excerpt(output, size=3000):
    """What a failed run says: from its first error on, without Java's stack
    frames, its start and its end if that is too long."""
    lines = output.splitlines()
    start = next((i for i, line in enumerate(lines)
                  if line.startswith("Error") or "exception" in line.lower()), 0)
    text = "\n".join(line for line in lines[start:] if not line.lstrip().startswith("at "))
    return text if len(text) <= size else text[:size // 2] + "\n...\n" + text[-size // 2:]


def run(jar, config, module, java, workers, heap, models=None):
    models = MODELS if models is None else models
    with tempfile.TemporaryDirectory() as metadir:
        memory = [f"-Xmx{heap}"] if heap else []
        # TLC evaluates a recursive operator on Java's stack: the trace specs
        # recurse over a whole history, and a 1 MiB thread stack overflowed on
        # CI now and then (AuthorityTrace, seeds 11 and 19 of v0.2's runs).
        command = [java, *memory, "-Xss16m", "-XX:+UseParallelGC", "-cp", str(jar), "tlc2.TLC",
                   "-workers", workers, "-metadir", metadir,
                   "-config", f"{config}.cfg", module]
        done = subprocess.run(command, cwd=models, capture_output=True, text=True)
    trace = re.search(r"^INVARIANT\s+TraceNotConsumed\b", (models / f"{config}.cfg").read_text(), re.M)
    return verdict(done.stdout + done.stderr, bool(trace)), done.stdout + done.stderr


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--full", action="store_true", help="include the slow rows")
    parser.add_argument("configs", nargs="*", help="only these configurations")
    parser.add_argument("--java", default=os.environ.get("JAVA", "java"))
    parser.add_argument("--workers", default="auto")
    parser.add_argument("--heap", help="maximum Java heap, such as 3g; TLC spills to disk beyond it")
    parser.add_argument("--shard", nargs=2, type=int, metavar=("INDEX", "COUNT"),
                        help="zero-based shard of the selected configurations")
    arguments = parser.parse_args()
    if arguments.shard and not 0 <= arguments.shard[0] < arguments.shard[1]:
        parser.error("--shard requires 0 <= INDEX < COUNT")
    jar = tlc_jar()
    failures = 0
    rows = [row for row in expectations()
            if (row[0] in arguments.configs if arguments.configs
                else arguments.full or row[2] == "fast")]
    if arguments.shard:
        index, count = arguments.shard
        rows = rows[index::count]
    for config, module, _, expected in rows:
        start = time.monotonic()
        got, output = run(jar, config, module, arguments.java, arguments.workers, arguments.heap)
        seconds = time.monotonic() - start
        status = "ok" if got == expected else "FAIL"
        print(f"{status:4} {config:12} expected {expected:26} got {got:26} {seconds:6.1f} s", flush=True)
        if got != expected:
            failures += 1
            print(excerpt(output, 4000), file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
