#!/bin/sh
# Installs a release of pigeon (14 §14.5) under PREFIX (~/.local/share/pigeon,
# ~/Library/Application Support/pigeon on macOS): the latest release, or
# --version's, checked against its SHA256SUMS; with --main, main's latest
# commit, built in PREFIX/src; with --source, a checkout's working tree,
# built where it is (scripts/install-local). The new copy of this script
# places it: the programs in PREFIX/bin (the old ones in bin.previous),
# git-annex (14 §14.3), a link in ~/.local/bin, pigeond's unit or agent
# (14 §14.4) and the launcher (ADR 0029). A release already here is not
# fetched again. With --join, which takes the rest of the arguments, it then
# runs `pigeon join` on the terminal.
#
#   curl -fsSL https://github.com/dont-feed-the/pigeon/releases/latest/download/pigeon-install | sh
#   pigeon-install [--version vX.Y.Z | --main | --source DIR | --rollback | --uninstall] [--system]
#   pigeon-install --join INVITATION [FOLDER] [--person NAME] [--backup-machine]
#
# --rollback puts PREFIX/bin.previous back; --no-service starts nothing.
# PIGEON_RELEASES names a directory laid out as GitHub's releases, and
# PIGEON_REPOSITORY the repository --main fetches, for tests.
set -eu

releases=${PIGEON_RELEASES:-https://github.com/dont-feed-the/pigeon/releases}
repository=${PIGEON_REPOSITORY:-https://github.com/dont-feed-the/pigeon.git}

die() { echo "pigeon-install: $*" >&2; exit 1; }
say() { echo "pigeon-install: $*"; }
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

# fetch ASSET TAG DEST: copies or downloads the release's ASSET to DEST.
fetch() {
  case $releases in
    https://*) curl -fsSL --retry 3 -o "$3" "$releases/download/$2/$1" ||
                 die "could not download $1 of $2; check the connection and try again" ;;
    *) cp "$releases/download/$2/$1" "$3" 2>/dev/null || die "$releases has no $1 for $2" ;;
  esac
}

# The tag of the latest release.
latest() {
  case $releases in
    https://*) curl -fsSLI -o /dev/null -w '%{url_effective}' "$releases/latest" | sed -n 's|.*/releases/tag/||p' ;;
    *) cat "$releases/latest" ;;
  esac
}

# The release installed in PREFIX/BIN, or nothing.
installed() { "$prefix/$1/pigeon" --version 2>/dev/null | sed -n 's/^pigeon /v/p'; }

case "$(uname -s)" in
  Darwin) os=macos prefix="$HOME/Library/Application Support/pigeon" ;;
  Linux) os=linux prefix="${XDG_DATA_HOME:-$HOME/.local/share}/pigeon" ;;
  *) die "pigeon runs on Linux and macOS" ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) arch=$(uname -m) ;;
esac
# quote ARG: ARG as one word of sh, for eval.
quote() { printf "'%s' " "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

version= rollback= main= source= uninstall= system= service=1 place= custom_prefix= joining= join_args=
while [ $# -gt 0 ]; do
  case $1 in
    --join)
      shift
      [ $# -gt 0 ] || die "--join needs an invitation"
      joining=1
      for a in "$@"; do join_args="$join_args$(quote "$a")"; done
      break ;;
    --version) version=${2:?--version needs a tag}; shift 2 ;;
    --rollback) rollback=1; shift ;;
    --main) main=1; shift ;;
    --source) source=${2:?--source needs a checkout}; main=1; shift 2 ;;
    --uninstall) uninstall=1; shift ;;
    --system) system=1; shift ;;
    --prefix) prefix=${2:?--prefix needs a directory}; custom_prefix=1; shift 2 ;;
    --no-service) service=; shift ;;
    --place) place=${2:?}; shift 2 ;;
    -h | --help) sed -n '2,15s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) die "unknown argument $1" ;;
  esac
done
if [ -n "$system" ]; then
  [ "$os" = linux ] || die "backup services require Linux"
  [ "$(id -u)" = 0 ] || die "run --system as root"
  [ -n "$custom_prefix" ] || prefix=/opt/pigeon
fi
case $prefix in /*) ;; *) die "--prefix must name an absolute directory" ;; esac
if [ -d "$prefix" ]; then prefix=$(cd "$prefix" && pwd -P); fi
case $prefix in / | /usr | /usr/local | /opt | /bin | /sbin) die "use a directory reserved for pigeon" ;; esac
if [ -n "$source" ]; then
  [ -d "$source" ] || die "--source $source is no directory"
  source=$(cd "$source" && pwd -P)
fi
if [ -z "$place" ]; then
  case "${version:+v}${main:+m}${rollback:+r}${uninstall:+u}" in
    ??*) die "choose one of --version, --main, --rollback and --uninstall" ;;
  esac
fi

# Ends the script: with --join, runs `pigeon join` with its arguments,
# reading the terminal even when this script came through a pipe.
finish() {
  [ -n "$joining" ] || exit 0
  eval "set -- $join_args"
  if (: </dev/tty) 2>/dev/null; then exec "$prefix/bin/pigeon" join "$@" </dev/tty; fi
  exec "$prefix/bin/pigeon" join "$@"
}

# Passes --join and its arguments on to the next stage of this script.
pass_join() { [ -z "$joining" ] || printf -- '--join %s' "$join_args"; }

# Writes pigeond's unit or agent and (re)starts it (14 §14.4).
start_service() {
  [ -n "$service" ] || return 0
  if [ -n "$system" ]; then set -- --system; else set --; fi
  helper="$prefix/bin/pigeon-service"
  # Releases before the service helper still support rollback.
  if [ ! -x "$helper" ]; then helper="$prefix/bin.previous/pigeon-service"; fi
  "$helper" --prefix "$prefix" "$@"
}

# Writes the launcher named "pigeon", which runs `pigeon open` (ADR 0029).
add_launcher() {
  if [ "$os" = macos ]; then
    app="$HOME/Applications/pigeon.app/Contents"
    mkdir -p "$app/MacOS"
    cat >"$app/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>pigeon</string>
  <key>CFBundleIdentifier</key><string>org.pigeon.launcher</string>
  <key>CFBundleExecutable</key><string>pigeon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
    escaped=$(printf '%s' "$prefix/bin/pigeon" | sed "s/'/'\\\\''/g")
    printf "#!/bin/sh\nexec '%s' open\n" "$escaped" >"$app/MacOS/pigeon"
    chmod +x "$app/MacOS/pigeon"
    say "the launcher is ~/Applications/pigeon.app"
  else
    apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    mkdir -p "$apps"
    cat >"$apps/pigeon.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=pigeon
Comment=See whether the group's files are safe
Comment[fr]=Voir si les fichiers du groupe sont en sécurité
Exec="$prefix/bin/pigeon" open
Icon=folder-remote
Terminal=false
Categories=Utility;FileTools;
DESKTOP
    say "the launcher is $apps/pigeon.desktop"
  fi
}

# Puts ~/.local/bin/pigeon on PREFIX/bin/pigeon and says whether it is the one found.
link_pigeon() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$prefix/bin/pigeon" "$HOME/.local/bin/pigeon"
  found=$(command -v pigeon 2>/dev/null || true)
  if [ "$found" = "$HOME/.local/bin/pigeon" ]; then
    say "pigeon is $found"
  elif [ -z "$found" ]; then
    say "add ~/.local/bin to your PATH:  export PATH=\"\$HOME/.local/bin:\$PATH\""
  else
    say "$found comes before ~/.local/bin/pigeon in your PATH: remove it, or put ~/.local/bin first"
  fi
}

if [ -n "$uninstall" ]; then
  [ -x "$prefix/bin/pigeon" ] && [ -f "$prefix/bin/pigeon-install" ] || die "no pigeon installation in $prefix"
  if [ -n "$service" ]; then
    if [ -n "$system" ]; then set -- --system; else set --; fi
    "$prefix/bin/pigeon-service" --prefix "$prefix" --stop "$@"
  fi
  if [ -z "$system" ]; then
    if [ "$(readlink "$HOME/.local/bin/pigeon" 2>/dev/null || true)" = "$prefix/bin/pigeon" ]; then
      rm -f "$HOME/.local/bin/pigeon"
      if [ "$os" = macos ]; then
        rm -rf "$HOME/Applications/pigeon.app"
      else
        rm -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/pigeon.desktop"
      fi
    fi
  fi
  rm -rf "$prefix/bin" "$prefix/bin.previous" "$prefix/git-annex" "$prefix/git-annex.linux"
  say "pigeon is uninstalled; your folders, repositories, settings and device key are kept"
  exit 0
fi

if [ -n "$rollback" ]; then
  [ -d "$prefix/bin.previous" ] || die "no previous release in $prefix/bin.previous"
  was=$(installed bin)
  mv "$prefix/bin" "$prefix/bin.rollback"
  mv "$prefix/bin.previous" "$prefix/bin"
  mv "$prefix/bin.rollback" "$prefix/bin.previous"
  start_service
  say "back to pigeon $(installed bin) (from $was)"
  exit 0
fi

if [ -z "$place" ] && [ -n "$main" ]; then
  # Build: main's latest commit in PREFIX/src, a clone only this script
  # touches, laid out as a release's archive; then main's script places it.
  command -v git >/dev/null 2>&1 || die "--main needs git"
  command -v cargo >/dev/null 2>&1 || die "--main needs Rust: install rustup (https://rustup.rs), then run this again"
  if [ -n "$source" ]; then
    # A checkout as it is: its commit, marked `.dirty` when tracked files
    # changed since, which its version cannot tell apart, so it is always
    # built and placed again.
    src=$source
    [ -f "$src/Cargo.toml" ] && [ -f "$src/packaging/pigeon-install" ] || die "$src is no pigeon checkout"
    commit=$(git -C "$src" rev-parse --short=12 HEAD) || die "$src is no git checkout"
    [ -z "$(git -C "$src" status --porcelain --untracked-files=no)" ] || commit="$commit.dirty"
  else
    src="$prefix/src"
    [ -d "$src/.git" ] || git init --quiet "$src"
    say "fetching main from $repository"
    git -C "$src" fetch --quiet --depth 1 "$repository" main || die "could not fetch main from $repository"
    git -C "$src" checkout --quiet --force --detach FETCH_HEAD
    commit=$(git -C "$src" rev-parse --short=12 HEAD)
  fi
  v=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$src/Cargo.toml" | head -n 1)
  version="v$v+g$commit"
  if [ "$(installed bin)" = "$version" ] && [ "${commit%.dirty}" = "$commit" ]; then
    say "pigeon $version is already installed in $prefix"
    finish
  fi
  say "building pigeon $version in $src"
  (cd "$src" && PIGEON_COMMIT=$commit cargo build --release --locked -p pigeond -p pigeon -p git-annex-p2p-iroh) ||
    die "the build of main failed"
  target=${CARGO_TARGET_DIR:-$src/target}
  mkdir -p "$prefix"
  tmp=$(mktemp -d "$prefix/.pigeon-install.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/release/bin"
  cp "$target/release/pigeon" "$target/release/pigeond" "$target/release/git-annex-p2p-iroh" \
    "$src/packaging/pigeon-install" "$src/packaging/install-git-annex" "$tmp/release/bin/"
  if [ -f "$src/packaging/pigeon-service" ]; then cp "$src/packaging/pigeon-service" "$tmp/release/bin/"; fi
  trap - EXIT
  if [ -n "$service" ]; then set --; else set -- --no-service; fi
  if [ -n "$system" ]; then set -- "$@" --system; fi
  eval "set -- \"\$@\" $(pass_join)"
  exec "$tmp/release/bin/pigeon-install" --place "$tmp" --version "$version" --main --source "$src" --prefix "$prefix" "$@"
fi

if [ -z "$place" ]; then
  # Fetch: the release's archive, checked, then its own script places it.
  [ -n "$version" ] || version=$(latest) || true
  [ -n "$version" ] || die "could not find the latest release at $releases"
  if [ "$(installed bin)" = "$version" ]; then
    say "pigeon $version is already installed in $prefix"
    finish
  fi
  archive="pigeon-$version-$os-$arch.tar.gz"
  mkdir -p "$prefix"
  tmp=$(mktemp -d "$prefix/.pigeon-install.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  say "fetching pigeon $version for $os-$arch"
  fetch SHA256SUMS "$version" "$tmp/SHA256SUMS"
  want=$(awk -v a="$archive" '$2 == a || $2 == "*" a { print $1 }' "$tmp/SHA256SUMS")
  [ -n "$want" ] || die "pigeon $version has no build for $os-$arch; build it from source (README.md)"
  fetch "$archive" "$version" "$tmp/archive.tar.gz"
  [ "$(sha256 "$tmp/archive.tar.gz")" = "$want" ] || die "$archive does not match its SHA256SUMS"
  mkdir "$tmp/release"
  tar -C "$tmp/release" -xzf "$tmp/archive.tar.gz"
  [ -x "$tmp/release/bin/pigeon-install" ] || die "$archive holds no bin/pigeon-install"
  trap - EXIT
  if [ -n "$service" ]; then set --; else set -- --no-service; fi
  if [ -n "$system" ]; then set -- "$@" --system; fi
  eval "set -- \"\$@\" $(pass_join)"
  exec "$tmp/release/bin/pigeon-install" --place "$tmp" --version "$version" --prefix "$prefix" "$@"
fi

# Place: this script is the release's, unpacked with SHA256SUMS in $place,
# or main's, built from PREFIX/src.
trap 'rm -rf "$place"' EXIT
got=$("$place/release/bin/pigeon" --version | sed -n 's/^pigeon /v/p')
[ "$got" = "$version" ] || die "the archive of $version holds pigeon $got"
annex="git-annex-pigeon-$os-$arch.tar.gz"
annex_sha=$(awk -v a="$annex" '$2 == a || $2 == "*" a { print $1 }' "$place/SHA256SUMS" 2>/dev/null || true)
if [ -n "$main" ]; then
  # The latest release's git-annex when main pins the same one; else built.
  tag=$(latest 2>/dev/null) || tag=
  sha=
  if [ -n "$tag" ] && (fetch SHA256SUMS "$tag" "$place/latest-SHA256SUMS") 2>/dev/null; then
    sha=$(awk -v a="$annex" '$2 == a || $2 == "*" a { print $1 }' "$place/latest-SHA256SUMS")
  fi
  if [ -n "$sha" ]; then
    "$place/release/bin/install-git-annex" --prefix "$prefix" --build "${source:-$prefix/src}/third_party/git-annex" \
      --archive "$releases/download/$tag/$annex" --sha256 "$sha" </dev/null
  else
    "$place/release/bin/install-git-annex" --prefix "$prefix" --build "${source:-$prefix/src}/third_party/git-annex" </dev/null
  fi
elif [ -n "$annex_sha" ]; then
  "$place/release/bin/install-git-annex" --prefix "$prefix" \
    --archive "$releases/download/$version/$annex" --sha256 "$annex_sha" </dev/null
else
  "$place/release/bin/install-git-annex" --prefix "$prefix" --stock </dev/null
fi
rm -rf "$prefix/bin.previous"
if [ -d "$prefix/bin" ]; then mv "$prefix/bin" "$prefix/bin.previous"; fi
mv "$place/release/bin" "$prefix/bin"
if [ -z "$system" ]; then link_pigeon; add_launcher; fi
start_service
say "pigeon $version is installed in $prefix"
finish
