#!/usr/bin/env python3
"""Render the Homebrew tap's formula from a published release's checksums.

The formula installs the same checked binaries and patched git-annex as the
shell installer. It never derives a checksum from an unchecked download.
"""

import argparse
import json
import re
from pathlib import Path


def formula(tag, checksums, repository):
    """A stable Apple Silicon formula for the two archives of this release."""
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?", tag):
        raise ValueError("the tag must be v followed by a release version")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        raise ValueError("the repository must be OWNER/NAME")
    sums = {}
    for line in checksums.splitlines():
        digest, name = line.split()
        name = name.removeprefix("*")
        if not re.fullmatch(r"[0-9a-f]{64}", digest) or name in sums:
            raise ValueError("invalid or duplicate checksum")
        sums[name] = digest
    pigeon = f"pigeon-{tag}-macos-arm64.tar.gz"
    annex = "git-annex-pigeon-macos-arm64.tar.gz"
    base = f"https://github.com/{repository}/releases/download/{tag}"
    # JSON quoting also protects the Ruby double-quoted string literals.
    q = json.dumps
    return f'''# Generated by packaging/homebrew-formula; changes belong in its template.
class Pigeon < Formula
  desc "Keep a group's files on its computers and say whether they are safe"
  homepage "https://github.com/{repository}"
  url {q(base + '/' + pigeon)}
  version {q(tag[1:])}
  sha256 {q(sums[pigeon])}
  license any_of: ["MIT", "Apache-2.0"]

  depends_on :macos
  depends_on arch: :arm64
  depends_on "git"

  resource "git-annex-pigeon" do
    url {q(base + '/' + annex)}
    sha256 {q(sums[annex])}
  end

  def install
    bin.install "bin/pigeon", "bin/pigeond", "bin/git-annex-p2p-iroh"
    resource("git-annex-pigeon").stage do
      # Homebrew strips a single enclosing directory (the archive's bin/).
      files = File.directory?("bin") ? Dir["bin/*"] : Dir["*"]
      (prefix/"git-annex/bin").install files
    end
    # Homebrew owns this installation, including its updates.
    (bin/"pigeon-install").write <<~SH
      #!/bin/sh
      echo 'Update pigeon with: brew upgrade pigeon' >&2
      exit 1
    SH
    chmod 0755, bin/"pigeon-install"
    app = prefix/"pigeon.app/Contents"
    (app/"MacOS").mkpath
    (app/"Info.plist").write <<~XML
      <?xml version="1.0" encoding="UTF-8"?>
      <plist version="1.0"><dict>
        <key>CFBundleName</key><string>pigeon</string>
        <key>CFBundleIdentifier</key><string>org.pigeon.launcher</string>
        <key>CFBundleExecutable</key><string>pigeon</string>
        <key>CFBundlePackageType</key><string>APPL</string>
        <key>LSUIElement</key><true/>
      </dict></plist>
    XML
    (app/"MacOS/pigeon").write "#!/bin/sh\\nexec '#{{opt_bin}}/pigeon' open\\n"
    chmod 0755, app/"MacOS/pigeon"
  end

  service do
    run [opt_bin/"pigeond"]
    keep_alive true
    process_type :background
    environment_variables PATH: std_service_path_env
  end

  def caveats
    <<~EOS
      Open the web interface with: pigeon open
      Add the launcher to Applications with:
        ln -s "#{{opt_prefix}}/pigeon.app" "$HOME/Applications/pigeon.app"
      Uninstalling keeps your shared folders, device key and settings.
    EOS
  end

  test do
    assert_equal "pigeon #{{version}}", shell_output("#{{bin}}/pigeon --version").strip
    assert_match "10.20261006-pigeon", shell_output("#{{prefix}}/git-annex/bin/git-annex version --raw").strip
  end
end
'''


def main():
    """Write the formula to stdout, failing if either asset is missing."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tag", required=True)
    parser.add_argument("--checksums", type=Path, required=True)
    parser.add_argument("--repository", default="dont-feed-the/pigeon")
    args = parser.parse_args()
    try:
        print(formula(args.tag, args.checksums.read_text(), args.repository), end="")
    except (ValueError, KeyError) as error:
        parser.error(str(error))


if __name__ == "__main__":
    main()
